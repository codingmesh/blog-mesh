# Public site origin used for canonical URLs, RSS, and the sitemap.
SITE_URL=https://your-domain.example

# Keystatic GitHub mode (production editing). Leave unset locally to use local mode.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=

# giscus comments. Comments render only when all three are set.
PUBLIC_GISCUS_REPO=codingmesh/blog-mesh
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY_ID=
