---
import '@fontsource-variable/space-grotesk/wght.css';
import '@fontsource-variable/hanken-grotesk/wght.css';
import '@fontsource-variable/hanken-grotesk/wght-italic.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import displayFont from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import bodyFont from '@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { site } from '../config';
import Icon from '../components/Icon.astro';
import Search from '../components/Search.astro';
interface Props { title?: string; description?: string; active?: string; article?: boolean; publishedAt?: Date; noindex?: boolean; home?: boolean; }
const { title, description = site.description, active, article = false, publishedAt, noindex = false, home = false } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={site.locale} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={site.themeColor.dark} data-light={site.themeColor.light} data-dark={site.themeColor.dark} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="font" type="font/woff2" href={displayFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={bodyFont} crossorigin />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}'s writing and notes`} href="/rss.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={site.ogLocale} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {article && <meta name="author" content={site.name} />}
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      // Dark is the default. A stored choice of light wins; the system preference is not consulted.
      (() => {
        let preference;
        try { preference = localStorage.getItem('theme'); } catch {}
        const theme = preference === 'light' ? 'light' : 'dark';
        const meta = document.querySelector('meta[name="theme-color"]');
        document.documentElement.dataset.theme = theme;
        meta.content = meta.dataset[theme];
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header" data-pagefind-ignore>
      {home
        ? <h1 class="brand"><a href="/" aria-label={`${site.name} home`}>{site.wordmark}<span class="brand-dot">.</span></a></h1>
        : <a href="/" class="brand" aria-label={`${site.name} home`}>{site.wordmark}<span class="brand-dot">.</span></a>}
      <div class="header-right">
        <nav aria-label="Main navigation">
          <a href="/writing/" aria-current={active === 'writing' ? 'page' : undefined}>Writing</a>
          <a href="/notes/" aria-current={active === 'notes' ? 'page' : undefined}>Notes</a>
          <a href="/about/" aria-current={active === 'about' ? 'page' : undefined}>About</a>
        </nav>
        <div class="header-tools">
          <button type="button" class="icon-button" id="search-open" aria-label="Search writing and notes" aria-haspopup="dialog" aria-controls="search-dialog" title="Search (⌘K / Ctrl+K)"><Icon name="search" /></button>
          <button type="button" class="icon-button" id="theme-toggle" aria-label="Switch to light mode" title="Switch theme"><span class="theme-moon"><Icon name="moon" /></span><span class="theme-sun"><Icon name="sun" /></span></button>
        </div>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer" data-pagefind-ignore>
      <div><a href="/" class="footer-name">{site.wordmark}<span>.</span></a><p>{site.focus}</p></div>
      <div class="footer-right"><a href="/rss.xml"><Icon name="rss" size={15} /> RSS</a><span>© {new Date().getFullYear()} {site.name}</span></div>
    </footer>
    <Search />
    <script>
      const button = document.querySelector<HTMLButtonElement>('#theme-toggle')!;
      const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')!;
      function applyTheme(theme: 'light' | 'dark') {
        document.documentElement.dataset.theme = theme;
        meta.content = meta.dataset[theme] || meta.content;
        const label = theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode';
        button.setAttribute('aria-label', label); button.title = label;
      }
      button.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        applyTheme(next);
        try { localStorage.setItem('theme', next); } catch {}
      });
      applyTheme(document.documentElement.dataset.theme === 'light' ? 'light' : 'dark');
    </script>
  </body>
</html>
