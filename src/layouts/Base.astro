---
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/base.css';
import { site } from '../config';
import Rail from '../components/site/Rail.astro';
import Footer from '../components/site/Footer.astro';
import Search from '../components/site/Search.astro';
interface Props {
  title?: string;
  description?: string;
  active?: string;
  article?: boolean;
  publishedAt?: Date;
  noindex?: boolean;
}
const { title, description = site.description, active, article = false, publishedAt, noindex = false } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={site.locale} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="theme-color"
      content={site.themeColor.dark}
      data-light={site.themeColor.light}
      data-dark={site.themeColor.dark}
    />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-display" preload={[{ weight: 700, style: 'normal', subset: 'latin' }]} />
    <Font cssVariable="--font-sans" preload={[{ weight: 400, style: 'normal', subset: 'latin' }]} />
    <Font cssVariable="--font-mono" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}'s writing and notes`} href="/rss.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={site.ogLocale} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {article && <meta name="author" content={site.name} />}
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      // Dark is the default. A stored choice of light wins; the system preference is not consulted.
      (() => {
        let preference;
        try {
          preference = localStorage.getItem('theme');
        } catch {}
        const theme = preference === 'light' ? 'light' : 'dark';
        const meta = document.querySelector('meta[name="theme-color"]');
        document.documentElement.dataset.theme = theme;
        meta.content = meta.dataset[theme];
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <div class="shell">
      <Rail active={active} />
      <main id="main" class="stage" tabindex="-1">
        <slot />
        <Footer />
      </main>
    </div>
    <Search />
  </body>
</html>
