---
/** One turn of a Transcript: who spoke, and what they said. Model turns longer than a screen start folded. */
interface Props {
  role?: 'user' | 'model' | 'system';
  /** Overrides the role label, for example a person's name or a specific model version. */
  name?: string;
}
const { role = 'user', name } = Astro.props;
const label = name || { user: 'User', system: 'System', model: '' }[role];
---

<div class:list={['turn', `turn-${role}`]} data-role={role}>
  <div class="turn-role">{label}</div>
  <div class="turn-body">
    <slot />
  </div>
</div>

<style>
  .turn {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr);
    gap: 14px;
    padding: 14px;
    border-bottom: 1px solid var(--line);
  }
  .turn:last-child {
    border-bottom: 0;
  }
  .turn-role {
    font: 500 12px/1.9 var(--mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
    overflow-wrap: anywhere;
  }
  .turn-model .turn-role,
  .turn-system .turn-role {
    color: var(--muted);
  }
  /* Without the script, a model turn with no name still says what it is. */
  .turn-model .turn-role:empty::before {
    content: 'Model';
  }
  .turn-body {
    position: relative;
    min-width: 0;
  }
  .turn-body :global(p) {
    margin: 0 0 8px;
  }
  .turn-body :global(p:last-child),
  .turn-body :global(pre:last-child) {
    margin-bottom: 0;
  }
  .turn-body :global(pre) {
    font-size: 13px;
  }
  .turn-body.is-folded {
    max-height: 320px;
    overflow: hidden;
  }
  .turn-body.is-folded::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 72px;
    background: linear-gradient(to bottom, transparent, var(--paper));
    pointer-events: none;
  }
  .turn :global(.turn-more) {
    grid-column: 2;
    justify-self: start;
    margin-top: 6px;
    border: 0;
    background: transparent;
    color: var(--accent);
    font: 500 12.5px/1.6 var(--mono);
    padding: 2px 0;
    cursor: pointer;
  }
  .turn :global(.turn-more:hover) {
    text-decoration: underline;
  }
  @media (max-width: 600px) {
    .turn {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
    .turn :global(.turn-more) {
      grid-column: 1;
    }
  }
</style>
