---
import type { MarkdownHeading } from 'astro';
/** A list in the right margin on wide screens; a collapsed disclosure above the body elsewhere. */
interface Props {
  headings: MarkdownHeading[];
  variant: 'side' | 'inline';
}
const { headings, variant } = Astro.props;
---

{variant === 'side' ? (
  <nav class="article-toc" aria-label="Table of contents" data-pagefind-ignore>
    <h2 class="label">On this page</h2>
    <ol>
      {headings.map((heading) => (
        <li class:list={{ 'toc-sub': heading.depth === 3 }}>
          <a href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))}
    </ol>
  </nav>
) : (
  <details class="mobile-toc" data-pagefind-ignore>
    <summary>
      Contents <span class="toc-count">{headings.length} sections</span>
    </summary>
    <ol>
      {headings.map((heading) => (
        <li>
          <a href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))}
    </ol>
  </details>
)}

<script>
  import { onPageLoad } from '../../scripts/page';
  import { initTableOfContents } from '../../scripts/toc';
  onPageLoad(() => initTableOfContents());
</script>

<style>
  .article-toc {
    position: sticky;
    top: 32px;
    font-size: 13.5px;
    color: var(--muted);
  }
  .article-toc .label {
    font-size: 11px;
    margin-bottom: 10px;
  }
  .article-toc ol {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .article-toc a {
    display: block;
    padding: 5px 0 5px 12px;
    border-left: 1px solid var(--line);
    line-height: 1.45;
    transition:
      color 140ms var(--ease),
      border-color 140ms var(--ease);
  }
  .article-toc a:hover {
    color: var(--ink);
  }
  .article-toc a[aria-current='location'] {
    border-left-color: var(--accent);
    color: var(--ink);
  }
  .toc-sub a {
    padding-left: 24px;
  }
  .mobile-toc {
    border-block: 1px solid var(--line);
    margin: 0 0 32px;
  }
  .mobile-toc summary {
    cursor: pointer;
    font: 500 13px/1.6 var(--mono);
    color: var(--accent);
    min-height: 44px;
    display: flex;
    align-items: center;
    gap: 10px;
    list-style: none;
  }
  .mobile-toc summary::-webkit-details-marker {
    display: none;
  }
  .mobile-toc summary::before {
    content: '';
    width: 7px;
    height: 7px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(-45deg);
    transition: transform 120ms var(--ease);
    flex-shrink: 0;
  }
  .mobile-toc[open] summary::before {
    transform: rotate(45deg);
  }
  .toc-count {
    color: var(--muted);
    font-weight: 400;
  }
  .mobile-toc ol {
    padding-left: 20px;
    margin: 4px 0 14px;
    font-size: 14px;
    color: var(--muted);
  }
  .mobile-toc li a {
    display: block;
    padding: 8px 0;
  }
  .mobile-toc li a:hover {
    color: var(--ink);
  }
</style>
