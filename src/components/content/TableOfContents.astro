---
import type { MarkdownHeading } from 'astro';
/**
 * The section headings of an article. The side list has a marker that slides to the current section; the inline
 * version is a collapsed disclosure above the body.
 */
interface Props {
  headings: MarkdownHeading[];
  variant: 'side' | 'inline';
}
const { headings, variant } = Astro.props;
---

{variant === 'side' ? (
  <nav class="article-toc" aria-label="Table of contents" data-pagefind-ignore>
    {/* The nav spans the article's height; this inner block is what sticks while the body scrolls. */}
    <div class="toc-sticky">
      <h2 class="toc-label">On this page</h2>
      <ol>
        <span class="toc-marker" aria-hidden="true" />
        {headings.map((heading) => (
          <li class:list={{ 'toc-sub': heading.depth === 3 }}>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ol>
    </div>
  </nav>
) : (
  <details class="mobile-toc" data-pagefind-ignore>
    <summary>
      Contents <span class="toc-count">{headings.length} sections</span>
    </summary>
    <ol>
      {headings.map((heading) => (
        <li class:list={{ 'toc-sub': heading.depth === 3 }}>
          <a href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))}
    </ol>
  </details>
)}

<script>
  import { onPageLoad } from '../../scripts/page';
  import { initTableOfContents } from '../../scripts/toc';
  onPageLoad(() => initTableOfContents());
</script>

<style>
  .article-toc {
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }
  .toc-sticky {
    position: sticky;
    top: 40px;
    max-height: calc(100vh - 80px);
    overflow-y: auto;
    scrollbar-width: none;
  }
  .toc-label {
    margin: 0 0 8px;
    font: 400 13px/1.8 var(--mono);
    color: var(--muted);
  }
  .article-toc ol {
    position: relative;
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 1px solid var(--line);
  }
  .toc-marker {
    position: absolute;
    left: -1px;
    top: 0;
    width: 2px;
    height: var(--toc-height, 0px);
    background: var(--accent);
    transform: translateY(var(--toc-top, 0px));
    transition:
      transform 300ms var(--ease),
      height 300ms var(--ease);
  }
  .article-toc a {
    display: block;
    padding: 4px 0 4px 12px;
    transition: color 140ms var(--ease);
  }
  .article-toc a:hover,
  .article-toc a[aria-current='location'] {
    color: var(--ink);
  }
  .toc-sub a {
    padding-left: 24px;
  }
  .mobile-toc {
    border-block: 1px solid var(--line);
    margin: 0 0 32px;
  }
  .mobile-toc summary {
    cursor: pointer;
    font: 400 13px/1.8 var(--mono);
    color: var(--accent);
    min-height: 44px;
    display: flex;
    align-items: center;
    gap: 10px;
    list-style: none;
  }
  .mobile-toc summary::-webkit-details-marker {
    display: none;
  }
  .mobile-toc summary::before {
    content: '';
    width: 7px;
    height: 7px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(-45deg);
    transition: transform 120ms var(--ease);
    flex-shrink: 0;
  }
  .mobile-toc[open] summary::before {
    transform: rotate(45deg);
  }
  .toc-count {
    color: var(--muted);
  }
  .mobile-toc ol {
    list-style: none;
    padding: 0;
    margin: 4px 0 14px;
    font-size: 15px;
    color: var(--muted);
  }
  .mobile-toc li a {
    display: block;
    padding: 8px 0;
  }
  .mobile-toc .toc-sub a {
    padding-left: 16px;
  }
  .mobile-toc li a:hover {
    color: var(--ink);
  }
</style>
