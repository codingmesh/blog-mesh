---
import type { MarkdownHeading } from 'astro';
/**
 * Numbered to match the section numerals in the body. The side list has a marker that slides to the
 * current section; the inline version is a collapsed disclosure above the body.
 */
interface Props {
  headings: MarkdownHeading[];
  variant: 'side' | 'inline';
}
const { headings, variant } = Astro.props;
let section = 0;
const entries = headings.map((heading) => ({
  ...heading,
  number: heading.depth === 2 ? String(++section).padStart(2, '0') : '',
}));
---

{variant === 'side' ? (
  <nav class="article-toc" aria-label="Table of contents" data-pagefind-ignore>
    <h2 class="label">On this page</h2>
    <ol>
      <span class="toc-marker" aria-hidden="true" />
      {entries.map((heading) => (
        <li class:list={{ 'toc-sub': heading.depth === 3 }}>
          <a href={`#${heading.slug}`}>
            <i>{heading.number}</i>
            <span>{heading.text}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
) : (
  <details class="mobile-toc" data-pagefind-ignore>
    <summary>
      Contents <span class="toc-count">{entries.length} sections</span>
    </summary>
    <ol>
      {entries.map((heading) => (
        <li class:list={{ 'toc-sub': heading.depth === 3 }}>
          <a href={`#${heading.slug}`}>
            <i>{heading.number}</i>
            <span>{heading.text}</span>
          </a>
        </li>
      ))}
    </ol>
  </details>
)}

<script>
  import { onPageLoad } from '../../scripts/page';
  import { initTableOfContents } from '../../scripts/toc';
  onPageLoad(() => initTableOfContents());
</script>

<style>
  .article-toc {
    position: sticky;
    top: 32px;
    font-size: 13.5px;
    color: var(--muted);
  }
  .article-toc .label {
    font-size: 11px;
    margin-bottom: 10px;
  }
  .article-toc ol {
    position: relative;
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 1px solid var(--line);
  }
  .toc-marker {
    position: absolute;
    left: -1px;
    top: 0;
    width: 2px;
    height: var(--toc-height, 0px);
    background: var(--accent);
    transform: translateY(var(--toc-top, 0px));
    transition:
      transform 300ms var(--ease),
      height 300ms var(--ease);
  }
  .article-toc a {
    display: grid;
    grid-template-columns: 26px minmax(0, 1fr);
    gap: 8px;
    padding: 6px 0 6px 12px;
    line-height: 1.4;
    transition: color 140ms var(--ease);
  }
  .article-toc a i {
    font: 500 12px/1.6 var(--mono);
    font-style: normal;
    color: var(--accent);
  }
  .article-toc a:hover,
  .article-toc a[aria-current='location'] {
    color: var(--ink);
  }
  .toc-sub a {
    padding-left: 24px;
  }
  .mobile-toc {
    border-block: 1px solid var(--line);
    margin: 0 0 32px;
  }
  .mobile-toc summary {
    cursor: pointer;
    font: 500 13px/1.6 var(--mono);
    color: var(--accent);
    min-height: 44px;
    display: flex;
    align-items: center;
    gap: 10px;
    list-style: none;
  }
  .mobile-toc summary::-webkit-details-marker {
    display: none;
  }
  .mobile-toc summary::before {
    content: '';
    width: 7px;
    height: 7px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(-45deg);
    transition: transform 120ms var(--ease);
    flex-shrink: 0;
  }
  .mobile-toc[open] summary::before {
    transform: rotate(45deg);
  }
  .toc-count {
    color: var(--muted);
    font-weight: 400;
  }
  .mobile-toc ol {
    list-style: none;
    padding: 0;
    margin: 4px 0 14px;
    font-size: 14px;
    color: var(--muted);
  }
  .mobile-toc li a {
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr);
    gap: 6px;
    padding: 8px 0;
  }
  .mobile-toc li a i {
    font: 500 12px/1.8 var(--mono);
    font-style: normal;
    color: var(--accent);
  }
  .mobile-toc li a:hover {
    color: var(--ink);
  }
</style>
