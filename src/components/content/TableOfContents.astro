---
import type { MarkdownHeading } from 'astro';
/**
 * The article's apparatus. The side variant is a sticky rail with the section list (a marker slides to the
 * current section), reading progress, and share actions; the inline variant is a collapsed
 * disclosure above the body on narrower screens.
 */
interface Props {
  headings: MarkdownHeading[];
  variant: 'side' | 'inline';
  /** Where the article's Markdown source is served, for "Copy as Markdown". */
  markdownHref?: string;
}
const { headings, variant, markdownHref } = Astro.props;
---

{variant === 'side' ? (
  <nav class="article-toc" aria-label="Article tools" data-pagefind-ignore>
    {/* The nav spans the article's height; this inner block is what sticks while the body scrolls. */}
    <div class="toc-sticky">
      <h2 class="toc-label">On this page</h2>
      <ol>
        {headings.map((heading) => (
          <li class:list={{ 'toc-sub': heading.depth === 3 }}>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ol>
      <div class="toc-progress" aria-hidden="true">
        <span class="toc-bar">
          <i />
        </span>
        <span class="toc-pct">0%</span>
      </div>
      <h2 class="toc-label toc-share-label">Share</h2>
      <ul class="toc-actions">
        <li>
          <button type="button" data-share="link">
            Copy link
          </button>
        </li>
        {markdownHref && (
          <li>
            <button type="button" data-share="markdown" data-href={markdownHref}>
              Copy as Markdown
            </button>
          </li>
        )}
        <li>
          <a href="/rss.xml">RSS</a>
        </li>
      </ul>
    </div>
  </nav>
) : (
  <details class="mobile-toc" data-pagefind-ignore>
    <summary>
      Contents <span class="toc-count">{headings.length} sections</span>
    </summary>
    <ol>
      {headings.map((heading) => (
        <li class:list={{ 'toc-sub': heading.depth === 3 }}>
          <a href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))}
    </ol>
  </details>
)}

<script>
  import { onPageLoad } from '../../scripts/page';
  import { initTableOfContents } from '../../scripts/toc';
  import { initShare } from '../../scripts/share';
  onPageLoad(() => {
    initTableOfContents();
    initShare();
  });
</script>

<style>
  /* Contents navigation and its labels are interface text in the sans (typography standard, section 2). */
  .article-toc {
    font: 400 15px/1.5 var(--sans);
    color: var(--muted);
  }
  .toc-sticky {
    position: sticky;
    top: 40px;
    max-height: calc(100vh - 80px);
    overflow-y: auto;
    scrollbar-width: none;
  }
  .toc-label {
    margin: 0 0 8px;
    font: 500 14px/1.5 var(--sans);
    color: var(--muted);
  }
  .article-toc ol {
    position: relative;
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 1px solid var(--line);
  }
  /* The marker is the list's own ::before: a 1px line stretched to the active link's height, so the slide is
     transform-only. It takes its first position without animating; the list is marked ready once placed. */
  .article-toc ol::before {
    content: '';
    position: absolute;
    left: -1px;
    top: 0;
    width: 2px;
    height: 1px;
    background: var(--accent);
    transform: translateY(var(--toc-top, 0px)) scaleY(var(--toc-height, 0));
    transform-origin: top;
  }
  .article-toc ol[data-ready]::before {
    transition: transform var(--move) var(--ease);
  }
  .article-toc ol a {
    display: block;
    padding: 4px 0 4px 12px;
    transition: color var(--fast) var(--ease);
  }
  .article-toc ol a:hover,
  .article-toc ol a[aria-current='location'] {
    color: var(--ink);
  }
  .toc-sub a {
    padding-left: 24px;
  }
  /* Progress as a dotted bar that fills with the accent, with the percentage beside it. */
  .toc-progress {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 18px 0 2px;
  }
  .toc-bar {
    position: relative;
    flex: 1;
    height: 8px;
    background: repeating-linear-gradient(90deg, var(--line) 0 2px, transparent 2px 4px);
  }
  /* The fill is clipped rather than resized, so scrolling never relays out the rail. */
  .toc-bar i {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--read-progress, 0%)) 0 0);
    background: repeating-linear-gradient(90deg, var(--accent) 0 2px, transparent 2px 4px);
  }
  .toc-pct {
    font: 400 14px/1.6 var(--sans);
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    margin: 0;
    min-width: 3ch;
  }
  .toc-share-label {
    margin-top: 28px;
  }
  .toc-actions {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--line);
  }
  .toc-actions li {
    padding: 0;
  }
  .toc-actions button,
  .toc-actions a {
    display: block;
    width: 100%;
    text-align: left;
    padding: 4px 0 4px 12px;
    border: 0;
    background: transparent;
    font: inherit;
    color: var(--muted);
    cursor: pointer;
    transition: color var(--fast) var(--ease);
  }
  .toc-actions button:hover,
  .toc-actions a:hover {
    color: var(--ink);
  }
  .toc-actions button.is-done {
    color: var(--accent);
  }
  .mobile-toc {
    border-block: 1px solid var(--line);
    margin: 0 0 24px;
  }
  .mobile-toc summary {
    cursor: pointer;
    font: 500 15px/1.4 var(--sans);
    color: var(--accent);
    min-height: 44px;
    display: flex;
    align-items: center;
    gap: 10px;
    list-style: none;
  }
  .mobile-toc summary::-webkit-details-marker {
    display: none;
  }
  .mobile-toc summary::before {
    content: '';
    width: 7px;
    height: 7px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(-45deg);
    transition: transform var(--fast) var(--ease);
    flex-shrink: 0;
  }
  .mobile-toc[open] summary::before {
    transform: rotate(45deg);
  }
  .toc-count {
    color: var(--muted);
    font-weight: 400;
  }
  .mobile-toc ol {
    list-style: none;
    padding: 0;
    margin: 4px 0 14px;
    font: 400 15px/1.5 var(--sans);
    color: var(--muted);
  }
  .mobile-toc li a {
    display: block;
    padding: 8px 0;
  }
  .mobile-toc .toc-sub a {
    padding-left: 16px;
  }
  .mobile-toc li a:hover {
    color: var(--ink);
  }
</style>
