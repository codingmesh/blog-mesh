<!-- Appears after a screen of scrolling; hidden from assistive technology until visible. -->
<a class="to-top" href="#main" aria-label="Back to top" data-pagefind-ignore>
  ↑
</a>
<script>
  import { onPageLoad } from '../../scripts/page';
  import { initBackToTop } from '../../scripts/back-to-top';
  onPageLoad(initBackToTop);
</script>

<style>
  .to-top {
    position: fixed;
    /* Above the article's contents rail, which spans the right margin and would otherwise take the pointer. */
    z-index: 10;
    right: 28px;
    bottom: 28px;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--paper);
    color: var(--muted);
    display: grid;
    place-items: center;
    font-size: 15px;
    box-shadow: 0 6px 20px rgb(20 20 20 / 0.08);
    opacity: 0;
    transform: translateY(8px);
    /* Hidden from the tab order and assistive technology as well as from sight; visibility flips after the fade. */
    visibility: hidden;
    transition:
      opacity var(--move) var(--ease),
      transform var(--move) var(--ease),
      visibility 0s var(--move),
      color var(--fast) var(--ease),
      border-color var(--fast) var(--ease);
  }
  .to-top[data-visible] {
    opacity: 1;
    transform: none;
    visibility: visible;
    transition-delay: 0s;
  }
  .to-top:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  @media (max-width: 600px) {
    .to-top {
      right: 16px;
      bottom: 16px;
    }
  }
  @media print {
    .to-top {
      display: none !important;
    }
  }
</style>
