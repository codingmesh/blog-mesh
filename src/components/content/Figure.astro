---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
/**
 * Replaces `img` in MDX, so Markdown image syntax renders as a captioned figure: the alt text is the caption,
 * local images are optimized to the column, and the link opens the full image (the lightbox takes it over when
 * scripts run). Plain Markdown files get the same shape from the rehype plugin in `src/lib/figures.ts`.
 */
interface Props {
  src: string | ImageMetadata;
  alt?: string;
  title?: string;
}
const { src, alt = '', title } = Astro.props;
const full = typeof src === 'string' ? src : src.src;
const caption = alt.trim();
---

{caption ? (
  <figure class="figure">
    <a class="figure-link" href={full} title={title}>
      {typeof src === 'string' ? (
        <img src={src} alt={alt} loading="lazy" decoding="async" />
      ) : (
        <Image src={src} alt={alt} widths={[720, 1440]} sizes="(max-width: 768px) 100vw, 720px" loading="lazy" />
      )}
    </a>
    <figcaption>{caption}</figcaption>
  </figure>
) : typeof src === 'string' ? (
  <img src={src} alt="" loading="lazy" decoding="async" />
) : (
  <Image src={src} alt="" widths={[720, 1440]} sizes="(max-width: 768px) 100vw, 720px" loading="lazy" />
)}
