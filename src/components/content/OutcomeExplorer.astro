---
/**
 * MDX-facing wrapper so articles can write <OutcomeExplorer /> without imports or client directives.
 * The React island hydrates when scrolled into view; its server HTML is the complete diagram.
 */
import Island from '../islands/OutcomeExplorer';
---

<Island client:visible />

<style is:global>
  .outcome-explorer {
    border: 1px solid var(--line);
    background: var(--soft);
    padding: 24px;
    border-radius: var(--radius);
    font-family: var(--sans);
  }
  .outcome-origin {
    margin: 0 auto;
    width: fit-content;
    padding: 8px 22px;
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    font-size: 15px;
    font-weight: 500;
    position: relative;
    background: var(--paper);
  }
  .outcome-origin::after {
    content: '';
    position: absolute;
    height: 22px;
    width: 1px;
    background: var(--accent);
    top: 100%;
    left: 50%;
  }
  .outcome-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding: 22px 0 0;
    list-style: none;
    gap: 14px;
    margin: 22px 0 0;
    border-top: 1px solid var(--accent);
  }
  .prose .outcome-list li,
  .outcome-list li {
    position: relative;
    margin: 0;
  }
  /* Connector lines redraw toward the selected outcome: the chosen one thickens, the others recede. */
  .outcome-list li::before {
    content: '';
    position: absolute;
    height: 22px;
    width: 1px;
    background: var(--accent);
    bottom: 100%;
    left: 50%;
    transform-origin: top;
    transition:
      opacity 260ms var(--ease),
      width 260ms var(--ease),
      transform 260ms var(--ease);
  }
  .outcome-list[data-selected] li:not([data-active])::before {
    opacity: 0.3;
  }
  .outcome-list li[data-active]::before {
    width: 2px;
    margin-left: -0.5px;
  }
  .outcome-list button {
    width: 100%;
    text-align: center;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 12px 8px;
    background: var(--paper);
    color: var(--ink);
    display: grid;
    gap: 3px;
  }
  .outcome-list button:hover {
    border-color: var(--accent);
  }
  .outcome-list button:active {
    transform: translateY(1px);
  }
  .outcome-list button[aria-pressed='true'] {
    background: var(--accent);
    color: var(--paper);
    border-color: var(--accent);
  }
  .outcome-list button[aria-pressed='true'] span {
    color: var(--paper);
  }
  /* Button text is the control role; the action beneath it is supporting text. */
  .outcome-list strong {
    font: 500 15px/1.4 var(--sans);
  }
  .outcome-list span {
    color: var(--muted);
    font: 400 14px/1.5 var(--sans);
  }
  .outcome-incomplete button {
    border-style: dashed;
    border-color: var(--accent);
  }
  /* Status text is supporting UI in the sans; only the code identifier is mono. The caption is figure text. */
  .outcome-result {
    display: block;
    margin-top: 18px;
    font: 400 14px/1.6 var(--sans);
    color: var(--muted);
    text-align: center;
    min-height: 1.6em;
  }
  .outcome-result code {
    font: 0.9em var(--mono);
    color: var(--accent);
  }
  .outcome-result q {
    color: var(--ink);
  }
  .outcome-explorer figcaption {
    color: var(--muted);
    font: 400 16px/1.5 var(--serif);
    text-align: center;
    margin-top: 14px;
  }
  @media (max-width: 600px) {
    .outcome-explorer {
      padding: 14px;
    }
    .outcome-list {
      grid-template-columns: 1fr;
      border-top: 0;
      padding: 0 0 0 16px;
      border-left: 1px solid var(--accent);
      margin: 22px 0 0 12px;
      gap: 12px;
    }
    .outcome-list li::before {
      width: 16px;
      height: 1px;
      left: -17px;
      top: 50%;
      bottom: auto;
    }
    /* Label over action, left aligned, so neither wraps on a phone. */
    .outcome-list button {
      text-align: left;
      gap: 2px;
      padding: 12px 14px;
    }
    .outcome-origin {
      margin-left: 0;
    }
    .outcome-origin::after {
      left: 12px;
    }
  }
  @media print {
    .outcome-explorer {
      break-inside: avoid;
    }
  }
</style>
