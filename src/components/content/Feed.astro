---
/** Vertical list of PostRow entries separated by hairlines. */
interface Props {
  compact?: boolean;
  class?: string;
}
const { compact = false, class: className } = Astro.props;
---

<ol class:list={['feed', { compact }, className]} role="list">
  <slot />
</ol>

<style>
  .feed {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .feed > :global(li + li) {
    border-top: 1px solid var(--line);
    padding-top: 40px;
    margin-top: 40px;
  }
  .feed.compact > :global(li + li) {
    padding-top: 18px;
    margin-top: 18px;
  }
  @media (max-width: 540px) {
    .feed > :global(li + li) {
      padding-top: 30px;
      margin-top: 30px;
    }
    .feed.compact > :global(li + li) {
      padding-top: 16px;
      margin-top: 16px;
    }
  }
</style>
