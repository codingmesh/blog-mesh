---
/** Vertical list of PostRow entries. The rows draw their own hairlines; the list closes with one. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<ol class:list={['feed', className]} role="list">
  <slot />
</ol>

<style>
  .feed {
    list-style: none;
    padding: 0;
    margin: 0;
    border-bottom: 1px solid var(--line);
  }
</style>
