---
/** The dialog that figures open into. One per article page; the script fills it from the clicked figure. */
---

<dialog id="lightbox" class="lightbox" aria-label="Enlarged figure" data-pagefind-ignore>
  <button type="button" class="lightbox-close icon-button" aria-label="Close">
    ×
  </button>
  <figure>
    <img alt="" />
    <figcaption></figcaption>
  </figure>
</dialog>

<script>
  import { onPageLoad } from '../../scripts/page.ts';
  import { initLightbox } from '../../scripts/lightbox.ts';
  onPageLoad(() => initLightbox());
</script>

<style>
  .lightbox {
    max-width: min(96vw, 1400px);
    max-height: 96vh;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--ink);
  }
  .lightbox::backdrop {
    background: color-mix(in srgb, var(--ink) 72%, transparent);
  }
  .lightbox figure {
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .lightbox img {
    display: block;
    max-width: 96vw;
    max-height: calc(96vh - 64px);
    width: auto;
    height: auto;
    object-fit: contain;
    view-transition-name: figure;
  }
  .lightbox figcaption {
    padding: 12px 18px 14px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }
  .lightbox figcaption:empty {
    display: none;
  }
  .lightbox-close {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: color-mix(in srgb, var(--paper) 85%, transparent);
    color: var(--ink);
    font: 24px/1 var(--sans);
    cursor: pointer;
  }
  .lightbox-close:hover {
    background: var(--paper);
  }
</style>
