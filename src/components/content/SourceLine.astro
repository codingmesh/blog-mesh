---
/** One-line citation for reading notes: title, author, and domain. */
interface Props {
  source: { title: string; url: string; author: string };
}
const { source } = Astro.props;
---

<p class="source-line" data-pagefind-ignore>
  Source:{' '}
  <a href={source.url} target="_blank" rel="noopener noreferrer">
    {source.title}
    <span class="sr-only"> (opens in a new tab)</span>
  </a>
  <span class="source-by">
    {source.author}, {new URL(source.url).hostname}
  </span>
</p>

<style>
  .source-line {
    font: 13px/1.7 var(--mono);
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  .source-line a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .source-line a:hover {
    color: var(--accent-ink);
  }
  .source-by {
    display: block;
  }
  @media print {
    .source-line {
      break-inside: avoid;
    }
  }
</style>
