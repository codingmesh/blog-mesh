---
/** Citation for reading notes, as one sentence: the source, and who wrote it where. */
interface Props {
  source: { title: string; url: string; author: string };
}
const { source } = Astro.props;
const host = new URL(source.url).hostname.replace(/^www\./, '');
---

<p class="source-line" data-pagefind-ignore>
  On{' '}
  <a href={source.url} target="_blank" rel="noopener noreferrer">
    {source.title}
    <span class="sr-only"> (opens in a new tab)</span>
    <span class="ext" aria-hidden="true">
      ↗
    </span>
  </a>{' '}
  by {source.author}, {host}.
</p>

<style>
  .source-line {
    margin: 14px 0 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  .source-line a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 3px;
    transition: text-decoration-color 150ms var(--ease);
  }
  .source-line a:hover {
    text-decoration-color: currentColor;
  }
  .ext {
    margin-left: 2px;
    font-size: 11px;
  }
</style>
