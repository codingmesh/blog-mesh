---
/** One-line citation for reading notes: title, author, and domain. */
interface Props {
  source: { title: string; url: string; author: string };
}
const { source } = Astro.props;
---

<p class="source-line" data-pagefind-ignore>
  <span class="source-title">
    Source:{' '}
    <a href={source.url} target="_blank" rel="noopener noreferrer">
      {source.title}
      <span class="sr-only"> (opens in a new tab)</span>
    </a>
  </span>
  <span class="source-by">
    {source.author}, {new URL(source.url).hostname}
  </span>
</p>

<style>
  .source-line {
    font: 13px/1.7 var(--mono);
    color: var(--muted);
    margin-bottom: 32px;
    overflow-wrap: anywhere;
  }
  .source-title,
  .source-by {
    display: block;
  }
  .source-by {
    opacity: 0.85;
  }
  .source-line a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .source-line a:hover {
    text-decoration-color: var(--accent);
  }
  @media (max-width: 540px) {
    .source-line {
      font-size: 12.5px;
      margin-bottom: 20px;
    }
  }
  @media print {
    .source-line {
      break-inside: avoid;
    }
  }
</style>
