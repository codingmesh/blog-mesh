---
/**
 * A conversation with a model, quoted as role-labeled turns. Long model turns fold; a control copies the prompt
 * alone. Available in MDX and as an editor block; the turns are `Turn` components inside it.
 */
interface Props {
  /** Who answered, shown in the head and as the default label of model turns. */
  model?: string;
  date?: string;
}
const { model = 'Model', date } = Astro.props;
---

<section class="transcript" data-model={model} aria-label={`Conversation with ${model}`}>
  <header class="transcript-head" data-pagefind-ignore>
    <span>
      {model}
      {date && <span class="transcript-date"> · {date}</span>}
    </span>
    <button type="button" class="transcript-copy">
      Copy prompt
    </button>
  </header>
  <div class="transcript-turns">
    <slot />
  </div>
</section>

<script>
  import { onPageLoad } from '../../scripts/page.ts';
  import { initTranscripts } from '../../scripts/transcript.ts';
  onPageLoad(() => initTranscripts());
</script>

<style>
  .transcript {
    margin: 28px 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    /* content-block prose in Newsreader; the head and its control are interface text in the sans. */
    font: 400 18px/1.6 var(--serif);
  }
  .transcript-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 7px 10px 7px 14px;
    border-bottom: 1px solid var(--line);
    background: var(--soft);
    font: 500 14px/1.5 var(--sans);
    color: var(--muted);
  }
  .transcript-date {
    font-weight: 400;
    color: var(--muted);
  }
  .transcript-copy {
    border: 0;
    background: transparent;
    color: var(--accent);
    font: 500 14px/1.5 var(--sans);
    padding: 4px 6px;
    border-radius: 4px;
    cursor: pointer;
  }
  .transcript-copy:hover {
    background: var(--line);
  }
  .transcript-copy.is-done {
    color: var(--muted);
  }
</style>
