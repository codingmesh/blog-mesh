---
import { formatDate, postUrl, readingTime, type Post } from '../../lib/content';
/** A post as a card. `featured` sets the newest piece large; the default is a grid tile. */
interface Props {
  post: Post;
  featured?: boolean;
  heading?: 'h2' | 'h3';
}
const { post, featured = false, heading = 'h3' } = Astro.props;
const Heading = heading;
const topic = post.data.tags[0];
---

<article class:list={['card', 'panel', { featured }]}>
  <p class="meta">
    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    <span>{readingTime(post.body)} min read</span>
    {topic && <span class="card-topic">{topic}</span>}
  </p>
  <Heading class="card-title">
    <a class="link-line" href={postUrl(post)}>
      {post.data.title}
    </a>
  </Heading>
  <p class="card-summary">{post.data.description}</p>
  {featured && (
    <a class="card-cta" href={postUrl(post)} aria-label={`Read ${post.data.title}`}>
      Read the article <span aria-hidden="true">→</span>
    </a>
  )}
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
    transition:
      border-color 160ms var(--ease),
      transform 180ms var(--ease),
      box-shadow 180ms var(--ease);
  }
  .card:hover {
    border-color: var(--line-strong);
    transform: translateY(-2px);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.04),
      0 14px 36px rgb(0 0 0 / 0.28);
  }
  .card-topic {
    color: var(--accent);
  }
  .card-title {
    font-size: 22px;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .card-title a {
    color: var(--ink);
    padding-bottom: 0.08em;
  }
  .card-title a::after {
    /* The whole card is clickable through the title link. */
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .card-title a:hover,
  .card-title a:focus-visible {
    color: var(--ink);
  }
  .card-summary {
    color: var(--muted);
    font-size: 15.5px;
    line-height: 1.55;
  }
  .featured {
    padding: 36px 40px;
    gap: 16px;
    background: radial-gradient(640px 280px at 100% 0%, var(--glow), transparent 70%), var(--surface);
  }
  .featured .card-title {
    font-size: clamp(30px, 3.6vw, 44px);
    letter-spacing: -0.03em;
    line-height: 1.06;
    max-width: 22ch;
  }
  .featured .card-summary {
    font-size: 18px;
    color: var(--ink);
    max-width: 56ch;
  }
  .card-cta {
    position: relative;
    z-index: 1;
    width: fit-content;
    margin-top: 6px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: 600 14px/1.4 var(--display);
    color: var(--accent);
  }
  .card-cta:hover {
    gap: 12px;
  }
  @media (max-width: 540px) {
    .card {
      padding: 20px;
    }
    .featured {
      padding: 24px 22px;
    }
    .featured .card-title {
      font-size: 30px;
    }
    .featured .card-summary {
      font-size: 17px;
    }
    .card-title {
      font-size: 20px;
    }
  }
</style>
