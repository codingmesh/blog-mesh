---
import { formatDate, postUrl, readingTime, type Post } from '../../lib/content';
/**
 * One entry in a list. The `row` variant is a date and a title, the `latest` variant adds the reading time, the topic,
 * and the one-line description. Titles carry a view-transition name so the clicked title morphs into the headline.
 */
interface Props {
  post: Post;
  variant?: 'row' | 'latest';
  heading?: 'h2' | 'h3';
}
const { post, variant = 'row', heading = 'h3' } = Astro.props;
const Heading = heading;
const topic = post.data.tags[0];
const transitionName = `title-${post.collection}-${post.id}`;
const date = post.data.date;
const yearMonth = `${date.getUTCFullYear()} · ${String(date.getUTCMonth() + 1).padStart(2, '0')}`;
---

{variant === 'latest' ? (
  <article class="latest archive-item" data-tags={JSON.stringify(post.data.tags)}>
    <Heading class="latest-title" transition:name={transitionName}>
      <a href={postUrl(post)}>{post.data.title}</a>
    </Heading>
    <p class="latest-when">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      <i>·</i>
      <span class="nowrap">{readingTime(post.body)} minute read</span>
      {topic && (
        <>
          <i>·</i>
          {topic}
        </>
      )}
    </p>
    <p class="latest-summary">
      {post.data.description} <a href={postUrl(post)}>Keep reading →</a>
    </p>
  </article>
) : (
  <li class="row archive-item" data-tags={JSON.stringify(post.data.tags)}>
    <time datetime={date.toISOString()}>{yearMonth}</time>
    <Heading class="row-title" transition:name={transitionName}>
      <a href={postUrl(post)}>{post.data.title}</a>
    </Heading>
  </li>
)}

<style>
  .row {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr);
    gap: 0 20px;
    align-items: baseline;
    padding: 7px 0;
  }
  .row time {
    font: 13px/1.8 var(--mono);
    color: var(--muted);
    white-space: nowrap;
  }
  .row-title {
    margin: 0;
    font-size: 17px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0;
    overflow-wrap: anywhere;
  }
  .row-title a {
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 3px;
    transition: text-decoration-color 150ms var(--ease);
  }
  .row-title a:hover,
  .row-title a:focus-visible {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
  .latest-title {
    margin: 0 0 6px;
    font-size: 26px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }
  .latest-title a:hover,
  .latest-title a:focus-visible {
    color: var(--accent);
  }
  .latest-when {
    margin: 0 0 10px;
    font: 13px/1.8 var(--mono);
    color: var(--muted);
  }
  .latest-when i {
    font-style: normal;
    margin: 0 6px;
    color: var(--muted);
    opacity: 0.55;
  }
  .latest-summary {
    margin: 0;
    font: 18px/1.6 var(--serif);
    color: var(--muted);
    max-width: 54ch;
  }
  .latest-summary a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 3px;
  }
  .latest-summary a:hover {
    text-decoration: underline;
  }
  @media (max-width: 600px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      padding: 10px 0;
    }
    .row time {
      line-height: 1.4;
    }
    .latest-title {
      font-size: 23px;
    }
  }
</style>
