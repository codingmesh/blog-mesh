---
import { formatDate, postUrl, readingTime, type Post } from '../../lib/content';
/** A post as a row: date in the left column, title and summary on the right. Used by the archive and notes pages. */
interface Props {
  post: Post;
  variant?: 'article' | 'note';
  heading?: 'h2' | 'h3';
}
const { post, variant = 'article', heading = 'h2' } = Astro.props;
const Heading = heading;
---

<li class:list={['row', 'archive-item', `row-${variant}`]} data-tags={JSON.stringify(post.data.tags)}>
  <p class="row-date">
    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    {variant === 'article' && <span>{readingTime(post.body)} min</span>}
  </p>
  <div class="row-body">
    <Heading class="row-title">
      <a class="link-line" href={postUrl(post)}>
        {post.data.title}
      </a>
    </Heading>
    <p class="row-summary">{post.data.description}</p>
  </div>
</li>

<style>
  .row {
    display: grid;
    grid-template-columns: 128px minmax(0, 1fr);
    column-gap: 24px;
    padding: 24px 0;
    border-top: 1px solid var(--line);
  }
  .row-date {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: 5px;
    font: 12.5px/1.6 var(--mono);
    color: var(--muted);
  }
  .row-title {
    font-size: 23px;
    letter-spacing: -0.022em;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }
  .row-title a {
    color: var(--ink);
    padding-bottom: 0.08em;
  }
  .row-title a:hover,
  .row-title a:focus-visible {
    color: var(--accent);
  }
  .row-summary {
    color: var(--muted);
    font-size: 16px;
    line-height: 1.55;
    margin-top: 8px;
    max-width: 60ch;
  }
  .row-note .row-title {
    font-size: 20px;
  }
  @media (max-width: 640px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 8px;
      padding: 20px 0;
    }
    .row-date {
      flex-direction: row;
      gap: 12px;
      padding-top: 0;
    }
    .row-title {
      font-size: 21px;
    }
    .row-summary {
      font-size: 15.5px;
    }
  }
</style>
