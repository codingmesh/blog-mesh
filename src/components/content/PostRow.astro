---
import { formatDate, postUrl, readingTime, type Post } from '../../lib/content';
/**
 * One entry in a list. The `row` variant is a date and a title, the `latest` variant adds the reading time, the topic,
 * and the one-line description. Titles carry a view-transition name so the clicked title morphs into the headline.
 * Dates use the site's formatter in the entry-meta role, as on article pages.
 */
interface Props {
  post: Post;
  variant?: 'row' | 'latest';
  heading?: 'h2' | 'h3';
}
const { post, variant = 'row', heading = 'h3' } = Astro.props;
const Heading = heading;
const topic = post.data.tags[0];
const transitionName = `title-${post.collection}-${post.id}`;
const date = post.data.date;
---

{variant === 'latest' ? (
  <article class="latest archive-item" data-tags={JSON.stringify(post.data.tags)}>
    <Heading class="latest-title" transition:name={transitionName}>
      <a href={postUrl(post)}>{post.data.title}</a>
    </Heading>
    <p class="latest-when">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      <i>·</i>
      <span class="nowrap">{readingTime(post.body)} minute read</span>
      {topic && (
        <>
          <i>·</i>
          {topic}
        </>
      )}
    </p>
    <p class="latest-summary">
      {post.data.description} <a href={postUrl(post)}>Keep reading →</a>
    </p>
  </article>
) : (
  <li class="row archive-item" data-tags={JSON.stringify(post.data.tags)}>
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
    <Heading class="row-title" transition:name={transitionName}>
      <a href={postUrl(post)}>{post.data.title}</a>
    </Heading>
    <span class="row-length">{post.collection === 'notes' ? 'note' : `${readingTime(post.body)} min`}</span>
  </li>
)}

<style>
  /* Roles: entry-meta for the date and length, entry-title for the title, featured-title and summary for Latest. */
  .row {
    display: grid;
    grid-template-columns: 7.5em minmax(0, 1fr) auto;
    gap: 0 20px;
    align-items: baseline;
    padding: 7px 0;
  }
  .row time,
  .row-length {
    font: 400 16px/1.5 var(--serif);
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    white-space: nowrap;
  }
  .row-length {
    text-align: right;
  }
  .row-title {
    margin: 0;
    font: 400 20px/1.5 var(--serif);
    overflow-wrap: anywhere;
  }
  .row-title a {
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 3px;
    transition:
      color var(--fast) var(--ease),
      text-decoration-color var(--fast) var(--ease);
  }
  .row-title a:hover,
  .row-title a:focus-visible {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
  .latest-title {
    margin: 0 0 6px;
    font: 600 28px/1.25 var(--serif);
    overflow-wrap: anywhere;
  }
  .latest-title a:hover,
  .latest-title a:focus-visible {
    color: var(--accent);
  }
  .latest-when {
    margin: 0 0 10px;
    font: 400 16px/1.5 var(--serif);
    color: var(--muted);
  }
  .latest-when i {
    font-style: normal;
    margin: 0 6px;
  }
  .latest-summary {
    margin: 0;
    font: 400 20px/1.6 var(--serif);
    color: var(--muted);
    max-width: 54ch;
  }
  .latest-summary a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 3px;
  }
  .latest-summary a:hover {
    text-decoration: underline;
  }
  @media (max-width: 600px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      padding: 10px 0;
    }
    .row time {
      line-height: 1.4;
    }
    .row-length {
      display: none;
    }
    .latest-title {
      font-size: 24px;
    }
    .latest-summary {
      font-size: 18px;
    }
  }
</style>
