---
import Icon from '../Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../../config';
/** Sticky left rail on desktop: identity, navigation, tools, and site links. Collapses to a top bar below 1024px. */
interface Props {
  active?: string;
}
const { active } = Astro.props;
const links = [
  { href: '/writing/', label: 'Writing', key: 'writing' },
  { href: '/notes/', label: 'Notes', key: 'notes' },
  { href: '/about/', label: 'About', key: 'about' },
];
---

<aside class="rail" data-pagefind-ignore>
  <a href="/" class="brand" aria-label={`${site.name} home`}>
    {site.wordmark}
    <span class="brand-dot">.</span>
  </a>
  <p class="rail-kicker">{site.focus}</p>
  <nav class="rail-nav" aria-label="Main navigation">
    {links.map((link) => (
      <a href={link.href} aria-current={active === link.key ? 'page' : undefined}>
        {link.label}
      </a>
    ))}
  </nav>
  <div class="rail-tools">
    <button
      type="button"
      class="search-trigger"
      id="search-open"
      aria-label="Search writing and notes"
      aria-haspopup="dialog"
      aria-controls="search-dialog"
      title="Search (⌘K / Ctrl+K)"
    >
      <Icon name="search" size={17} />
      <span class="search-text">Search</span>
      <kbd class="search-kbd">⌘K</kbd>
    </button>
    <ThemeToggle />
  </div>
  <div class="rail-foot">
    <a href="/rss.xml">
      <Icon name="rss" size={14} /> RSS
    </a>
    <span>
      © {new Date().getFullYear()} {site.name}
    </span>
  </div>
</aside>

<style>
  .rail {
    position: sticky;
    top: 0;
    height: 100dvh;
    width: var(--rail-width);
    flex-shrink: 0;
    background: var(--rail);
    border-right: 1px solid var(--line);
    padding: 40px 28px 28px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .brand {
    font: 700 26px/1 var(--display);
    letter-spacing: -0.035em;
    color: var(--ink);
    width: fit-content;
  }
  .brand:hover {
    color: var(--ink);
  }
  .brand-dot {
    color: var(--accent);
  }
  .rail-kicker {
    font: 500 13px/1.6 var(--mono);
    color: var(--muted);
    margin-top: -14px;
  }
  .rail-nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 8px;
  }
  .rail-nav a {
    position: relative;
    font: 500 16px/1.3 var(--sans);
    color: var(--muted);
    padding: 9px 12px 9px 14px;
    border-radius: var(--radius-sm);
  }
  .rail-nav a:hover {
    color: var(--ink);
    background: var(--soft);
  }
  .rail-nav a[aria-current='page'] {
    color: var(--ink);
    background: var(--soft);
  }
  .rail-nav a[aria-current='page']::before {
    content: '';
    position: absolute;
    left: 0;
    top: 10px;
    bottom: 10px;
    width: 2px;
    border-radius: 2px;
    background: var(--accent);
  }
  .rail-tools {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .search-trigger {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 42px;
    padding: 0 12px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--muted);
    font: 500 14px/1.4 var(--sans);
    text-align: left;
  }
  .search-trigger:hover {
    color: var(--ink);
    border-color: var(--accent);
  }
  .search-text {
    flex: 1;
  }
  .rail-foot {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font: 12.5px/1.6 var(--mono);
    color: var(--muted);
  }
  .rail-foot a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .rail-foot a:hover {
    color: var(--ink);
  }
  @media (max-width: 1023px) {
    .rail {
      position: static;
      height: auto;
      width: auto;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      min-height: 64px;
      padding: 0 20px;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
    .brand {
      font-size: 21px;
    }
    .rail-kicker,
    .rail-foot,
    .search-text,
    .search-kbd {
      display: none;
    }
    .rail-nav {
      flex-direction: row;
      gap: 2px;
      margin: 0 auto 0 8px;
    }
    .rail-nav a {
      font-size: 14px;
      padding: 10px 10px;
    }
    .rail-nav a[aria-current='page']::before {
      display: none;
    }
    .rail-nav a[aria-current='page'] {
      background: transparent;
      text-decoration: underline;
      text-decoration-color: var(--accent);
      text-decoration-thickness: 2px;
      text-underline-offset: 6px;
    }
    .rail-tools {
      gap: 2px;
    }
    .search-trigger {
      flex: none;
      width: 44px;
      height: 44px;
      min-height: 0;
      padding: 0;
      justify-content: center;
      border: 0;
      background: transparent;
    }
  }
  @media (max-width: 440px) {
    /* Narrow phones: identity and tools on the first row, navigation on its own row below. */
    .rail {
      flex-wrap: wrap;
      padding: 0 16px;
      row-gap: 0;
    }
    .brand {
      font-size: 19px;
      padding: 12px 0;
    }
    .rail-tools {
      margin-left: auto;
    }
    .rail-nav {
      order: 3;
      flex-basis: 100%;
      margin: 0 -16px;
      padding: 0 8px;
      border-top: 1px solid var(--line);
      justify-content: flex-start;
    }
    .rail-nav a {
      font-size: 14px;
      padding: 10px 10px;
    }
  }
  @media print {
    .rail {
      display: none !important;
    }
  }
</style>
