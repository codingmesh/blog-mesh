---
import Icon from '../Icon.astro';
---

<button type="button" class="icon-button" id="theme-toggle" aria-label="Switch to light mode" title="Switch theme">
  <span class="theme-moon">
    <Icon name="moon" size={18} />
  </span>
  <span class="theme-sun">
    <Icon name="sun" size={18} />
  </span>
</button>

<script>
  import { initThemeToggle } from '../../scripts/theme';
  initThemeToggle();
</script>

<style>
  .icon-button {
    border: 1px solid var(--line-strong);
    padding: 0;
    background: var(--surface);
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-sm);
    color: var(--muted);
    flex-shrink: 0;
  }
  .icon-button:hover {
    color: var(--ink);
    border-color: var(--accent);
  }
  .theme-moon,
  :global([data-theme='light']) .theme-sun {
    display: none;
  }
  :global([data-theme='light']) .theme-moon {
    display: block;
  }
  @media (max-width: 1023px) {
    .icon-button {
      width: 44px;
      height: 44px;
      border: 0;
      background: transparent;
    }
  }
</style>
