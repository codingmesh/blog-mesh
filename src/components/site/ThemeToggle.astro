---
import Icon from '../Icon.astro';
---

<button type="button" class="icon-button" id="theme-toggle" aria-label="Switch to dark mode" title="Switch theme">
  <span class="theme-moon">
    <Icon name="moon" size={17} />
  </span>
  <span class="theme-sun">
    <Icon name="sun" size={17} />
  </span>
</button>

<script>
  import { initThemeToggle } from '../../scripts/theme';
  initThemeToggle();
</script>

<style>
  .icon-button {
    border: 0;
    padding: 0;
    background: transparent;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: var(--radius);
    color: var(--muted);
    flex-shrink: 0;
  }
  .icon-button:hover {
    color: var(--ink);
    background: var(--soft);
  }
  /* Show the destination: a moon while light, a sun while dark. */
  .theme-sun,
  :global([data-theme='dark']) .theme-moon {
    display: none;
  }
  :global([data-theme='dark']) .theme-sun {
    display: block;
  }
</style>
