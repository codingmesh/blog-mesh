---
import { site } from '../../config';
/** The feed link and the year. Third-party notices live at /third-party-notices.txt. */
---

<footer class="foot wrap" data-pagefind-ignore transition:animate="none">
  <p class="foot-meta">
    <a href="/rss.xml">RSS</a>
    <span>
      © {new Date().getFullYear()} {site.name}
    </span>
  </p>
</footer>

<style>
  .foot {
    margin: 96px auto 48px;
    padding-top: 24px;
    border-top: 1px solid var(--ink);
    font: 400 14px/1.6 var(--sans);
    color: var(--muted);
  }
  .foot a {
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 3px;
  }
  .foot a:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
  .foot-meta {
    display: flex;
    gap: 18px;
    margin: 0;
  }
  @media (max-width: 600px) {
    .foot {
      margin: 64px auto 40px;
    }
    /* Thumb-sized links; the padding is pulled back so the text keeps its line. */
    .foot a {
      display: inline-block;
      padding: 9px 0;
      margin: -9px 0;
    }
  }
  @media print {
    .foot {
      display: none !important;
    }
  }
</style>
