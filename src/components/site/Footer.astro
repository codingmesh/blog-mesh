---
import { site } from '../../config';
---

<footer class="foot wrap" data-pagefind-ignore>
  <span>
    {site.wordmark} <span class="sep">·</span> <a href="/rss.xml">RSS</a>
  </span>
  <span>
    © {new Date().getFullYear()} {site.name}
  </span>
</footer>

<style>
  .foot {
    margin: 96px auto 48px;
    padding-top: 24px;
    border-top: 1px solid var(--ink);
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font: 13px/1.6 var(--mono);
    color: var(--muted);
  }
  .sep {
    margin: 0 4px;
  }
  .foot a:hover {
    color: var(--accent);
  }
  @media (max-width: 540px) {
    .foot {
      margin: 64px auto 40px;
    }
  }
  @media print {
    .foot {
      display: none !important;
    }
  }
</style>
