---
import Icon from '../Icon.astro';
import { site } from '../../config';
/** Shown below 1024px, where the rail collapses to a top bar and loses its footer links. */
---

<footer class="site-footer" data-pagefind-ignore>
  <span>
    © {new Date().getFullYear()} {site.name}
  </span>
  <a href="/rss.xml">
    <Icon name="rss" size={14} /> RSS
  </a>
</footer>

<style>
  .site-footer {
    display: none;
  }
  @media (max-width: 1023px) {
    .site-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 24px 20px 40px;
      border-top: 1px solid var(--line);
      font: 12.5px/1.6 var(--mono);
      color: var(--muted);
    }
    .site-footer a {
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
  }
  @media print {
    .site-footer {
      display: none !important;
    }
  }
</style>
