---
import Icon from '../Icon.astro';
import { site } from '../../config';
---

<footer class="site-footer" data-pagefind-ignore>
  <div class="site-footer-inner column">
    <div>
      <a href="/" class="footer-name">
        {site.wordmark}
        <span>.</span>
      </a>
      <p>{site.focus}</p>
    </div>
    <div class="footer-right">
      <a href="/rss.xml">
        <Icon name="rss" size={15} /> RSS
      </a>
      <span>
        © {new Date().getFullYear()} {site.name}
      </span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 96px;
    border-top: 1px solid var(--line);
  }
  .site-footer-inner {
    padding: 28px 0 48px;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    font: 13px/1.6 var(--mono);
    color: var(--muted);
  }
  .footer-name {
    font: 700 15px/1 var(--display);
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .footer-name span {
    color: var(--accent);
  }
  p {
    margin-top: 8px;
  }
  .footer-right {
    display: flex;
    gap: 20px;
    align-items: center;
  }
  .footer-right a {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .footer-right a:hover {
    color: var(--ink);
  }
  @media (max-width: 540px) {
    .site-footer {
      margin-top: 72px;
    }
    .site-footer-inner {
      flex-direction: column;
      gap: 10px;
      padding-bottom: 40px;
    }
  }
  @media print {
    .site-footer {
      display: none !important;
    }
  }
</style>
