---
import Icon from '../Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../../config';
/** The name on the left, with a crumb to the section on article pages; navigation, search, and theme on the right. */
interface Props {
  active?: string;
  crumb?: { label: string; href: string };
}
const { active, crumb } = Astro.props;
---

<header class="top wrap" data-pagefind-ignore transition:animate="none">
  <p class="name">
    <a href="/">{site.name}</a>
    {crumb && (
      <span class="crumb">
        {' / '}
        <a href={crumb.href}>{crumb.label}</a>
      </span>
    )}
  </p>
  <nav aria-label="Main navigation">
    <a href="/writing/" aria-current={active === 'writing' ? 'page' : undefined}>
      Writing
    </a>
    <a href="/notes/" aria-current={active === 'notes' ? 'page' : undefined}>
      Notes
    </a>
    <a href="/about/" aria-current={active === 'about' ? 'page' : undefined}>
      About
    </a>
    <button
      type="button"
      class="search-trigger"
      id="search-open"
      aria-label="Search writing and notes"
      aria-haspopup="dialog"
      aria-controls="search-dialog"
      title="Search (⌘K / Ctrl+K)"
    >
      <Icon name="search" size={15} />
      <span>Search</span>
      <kbd aria-hidden="true">⌘K</kbd>
    </button>
    <ThemeToggle />
  </nav>
</header>

<style>
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 32px 0 0;
  }
  .name {
    margin: 0;
    font-weight: 600;
    font-size: 17px;
    letter-spacing: -0.01em;
    line-height: 1.6;
  }
  .name a:hover {
    color: var(--accent);
  }
  .crumb {
    font-weight: 400;
    color: var(--muted);
  }
  .crumb a:hover {
    color: var(--ink);
  }
  nav {
    display: flex;
    align-items: center;
    gap: 22px;
    font-size: 15px;
    color: var(--muted);
  }
  nav a {
    padding: 4px 0;
    line-height: 1.6;
  }
  nav a:hover {
    color: var(--ink);
  }
  nav a[aria-current='page'] {
    color: var(--ink);
  }
  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 0;
    border: 0;
    background: transparent;
    font: inherit;
    color: inherit;
    line-height: 1.6;
  }
  .search-trigger:hover {
    color: var(--ink);
  }
  .search-trigger kbd {
    margin-left: 2px;
  }
  @media (max-width: 600px) {
    .top {
      padding-top: 20px;
    }
    .search-trigger kbd,
    .search-trigger span {
      display: none;
    }
    nav {
      gap: 14px;
      font-size: 14px;
    }
    .search-trigger {
      width: 40px;
      height: 40px;
      justify-content: center;
    }
  }
  @media (max-width: 400px) {
    /* Narrow phones: name on the first row, navigation on its own row below. */
    .top {
      flex-wrap: wrap;
      row-gap: 0;
    }
    nav {
      width: 100%;
      gap: 14px;
    }
  }
  @media print {
    .top {
      display: none !important;
    }
  }
</style>
