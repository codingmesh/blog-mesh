---
import Icon from '../Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../../config';
/** Mark, name, and focus on the left; navigation, search, and theme on the right. */
interface Props {
  active?: string;
}
const { active } = Astro.props;
---

<header class="top wrap" data-pagefind-ignore transition:animate="none">
  <a class="name" href="/">
    <span class="mark" aria-hidden="true"></span>
    <span class="name-text">
      {site.name}
      <small>{site.focus}</small>
    </span>
  </a>
  <nav aria-label="Main navigation">
    <a href="/writing/" aria-current={active === 'writing' ? 'page' : undefined}>
      Writing
    </a>
    <a href="/notes/" aria-current={active === 'notes' ? 'page' : undefined}>
      Notes
    </a>
    <a href="/about/" aria-current={active === 'about' ? 'page' : undefined}>
      About
    </a>
    <button
      type="button"
      class="search-trigger"
      id="search-open"
      aria-label="Search writing and notes"
      aria-haspopup="dialog"
      aria-controls="search-dialog"
      title="Search (⌘K / Ctrl+K)"
    >
      <Icon name="search" size={15} />
      <span>Search</span>
      <kbd>⌘K</kbd>
    </button>
    <ThemeToggle />
  </nav>
</header>

<style>
  .top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    padding: 28px 0 0;
  }
  .name {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-weight: 600;
    font-size: 17px;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .mark {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    background: var(--accent);
    margin-top: 5px;
    flex-shrink: 0;
    transition: transform 160ms var(--ease);
  }
  .name:hover .mark {
    transform: rotate(45deg);
  }
  .name small {
    display: block;
    font: 400 13px/1.5 var(--mono);
    color: var(--muted);
    margin-top: 2px;
  }
  .name:hover {
    color: var(--accent);
  }
  nav {
    display: flex;
    align-items: center;
    gap: 22px;
    font-size: 15px;
    color: var(--muted);
    padding-top: 1px;
  }
  nav a {
    padding: 4px 0;
    line-height: 1.6;
  }
  nav a:hover {
    color: var(--ink);
  }
  nav a[aria-current='page'] {
    color: var(--ink);
    box-shadow: inset 0 -2px 0 var(--accent);
  }
  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 0;
    border: 0;
    background: transparent;
    font: inherit;
    color: inherit;
    line-height: 1.6;
  }
  .search-trigger:hover {
    color: var(--ink);
  }
  .search-trigger kbd {
    margin-left: 2px;
  }
  @media (max-width: 600px) {
    .top {
      padding-top: 20px;
      align-items: center;
    }
    .name small,
    .search-trigger kbd,
    .search-trigger span {
      display: none;
    }
    .name {
      align-items: center;
    }
    .mark {
      margin-top: 0;
    }
    nav {
      gap: 14px;
      font-size: 14px;
    }
    .search-trigger {
      width: 40px;
      height: 40px;
      justify-content: center;
    }
  }
  @media (max-width: 400px) {
    /* Narrow phones: name on the first row, navigation on its own row below. */
    .top {
      flex-wrap: wrap;
      row-gap: 0;
    }
    nav {
      width: 100%;
      gap: 14px;
      padding-top: 0;
    }
  }
  @media print {
    .top {
      display: none !important;
    }
  }
</style>
