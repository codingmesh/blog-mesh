---
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../../config';
/** Name and focus on the left, navigation on the right. The search entry is a button that opens the dialog. */
interface Props {
  active?: string;
}
const { active } = Astro.props;
---

<header class="top wrap" data-pagefind-ignore>
  <a class="name" href="/">
    {site.name}
    <small>{site.focus}</small>
  </a>
  <nav aria-label="Main navigation">
    <a href="/writing/" aria-current={active === 'writing' ? 'page' : undefined}>
      Writing
    </a>
    <a href="/notes/" aria-current={active === 'notes' ? 'page' : undefined}>
      Notes
    </a>
    <a href="/about/" aria-current={active === 'about' ? 'page' : undefined}>
      About
    </a>
    <button
      type="button"
      id="search-open"
      aria-label="Search writing and notes"
      aria-haspopup="dialog"
      aria-controls="search-dialog"
      title="Search (⌘K / Ctrl+K)"
    >
      Search
    </button>
    <ThemeToggle />
  </nav>
</header>

<style>
  .top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    padding: 28px 0 0;
  }
  .name {
    font-weight: 600;
    font-size: 17px;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .name small {
    display: block;
    font: 400 13px/1.5 var(--mono);
    color: var(--muted);
    margin-top: 2px;
  }
  .name:hover {
    color: var(--accent);
  }
  nav {
    display: flex;
    align-items: center;
    gap: 22px;
    font-size: 15px;
    color: var(--muted);
    padding-top: 1px;
  }
  nav a,
  nav button {
    padding: 4px 0;
    border: 0;
    background: transparent;
    font: inherit;
    color: inherit;
    line-height: 1.6;
  }
  nav a:hover,
  nav button:hover {
    color: var(--ink);
  }
  nav a[aria-current='page'] {
    color: var(--ink);
    box-shadow: inset 0 -2px 0 var(--accent);
  }
  @media (max-width: 600px) {
    .top {
      padding-top: 20px;
      align-items: center;
    }
    .name small {
      display: none;
    }
    nav {
      gap: 14px;
      font-size: 14px;
    }
  }
  @media (max-width: 400px) {
    /* Narrow phones: name on the first row, navigation on its own row below. */
    .top {
      flex-wrap: wrap;
      row-gap: 2px;
    }
    nav {
      width: 100%;
      gap: 16px;
      padding-top: 0;
    }
  }
  @media print {
    .top {
      display: none !important;
    }
  }
</style>
