---
import Icon from '../Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../../config';
/** The name on the left, with a crumb to the section on article pages; navigation, search, and theme on the right. */
interface Props {
  active?: string;
  crumb?: { label: string; href: string };
}
const { active, crumb } = Astro.props;
---

<header class="top wrap" data-pagefind-ignore transition:animate="none">
  <p class="name">
    <a href="/">{site.name}</a>
    {crumb && (
      <span class="crumb">
        {' / '}
        <a href={crumb.href}>{crumb.label}</a>
      </span>
    )}
  </p>
  <nav aria-label="Main navigation">
    <a href="/writing/" aria-current={active === 'writing' ? 'page' : undefined}>
      Writing <kbd aria-hidden="true">W</kbd>
    </a>
    <a href="/notes/" aria-current={active === 'notes' ? 'page' : undefined}>
      Notes <kbd aria-hidden="true">N</kbd>
    </a>
    <a href="/about/" aria-current={active === 'about' ? 'page' : undefined}>
      About <kbd aria-hidden="true">A</kbd>
    </a>
    <button
      type="button"
      class="search-trigger"
      id="search-open"
      aria-haspopup="dialog"
      aria-controls="search-dialog"
      title="Search (S, or ⌘K / Ctrl+K)"
    >
      <Icon name="search" size={15} />
      <span class="search-text">Search</span>
      <kbd>S</kbd>
    </button>
    <ThemeToggle />
  </nav>
</header>

<script>
  import { onPageLoad } from '../../scripts/page';
  import { initShortcuts } from '../../scripts/shortcuts';
  onPageLoad(initShortcuts);
</script>

<style>
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 32px 0 0;
  }
  /* site-name role: Folio Sans 600 at 17px, normal tracking. */
  .name {
    margin: 0;
    font-weight: 600;
    font-size: 17px;
    line-height: 1.6;
  }
  .name a:hover {
    color: var(--accent);
  }
  .crumb {
    font-weight: 400;
    color: var(--muted);
  }
  .crumb a:hover {
    color: var(--ink);
  }
  nav {
    display: flex;
    align-items: center;
    gap: 22px;
    font-size: 15px;
    color: var(--muted);
  }
  nav a {
    padding: 4px 0;
    line-height: 1.6;
  }
  nav a:hover {
    color: var(--ink);
  }
  nav a[aria-current='page'] {
    color: var(--ink);
  }
  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 0;
    border: 0;
    background: transparent;
    font: inherit;
    color: inherit;
    line-height: 1.6;
  }
  .search-trigger:hover {
    color: var(--ink);
  }
  .search-trigger kbd {
    margin-left: 2px;
  }
  /* Key hints: visible on pointer screens where a keyboard is likely, hidden on phones and when the reader has
     turned the shortcuts off (About page). */
  nav a kbd {
    margin-left: 4px;
    vertical-align: 1px;
  }
  @media (max-width: 600px), (hover: none) {
    nav a kbd {
      display: none;
    }
  }
  :global(html[data-shortcuts='off']) nav kbd {
    display: none;
  }
  @media (max-width: 600px) {
    .top {
      padding-top: 20px;
    }
    .search-trigger kbd {
      display: none;
    }
    /* The word stays in the accessible name while only the icon shows. */
    .search-text {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    nav {
      gap: 14px;
      font-size: 14px;
    }
    /* Thumb-sized links, level with the 40px buttons beside them. */
    nav a {
      display: inline-flex;
      align-items: center;
      min-height: 40px;
    }
    .search-trigger {
      width: 40px;
      height: 40px;
      justify-content: center;
    }
  }
  @media (max-width: 400px) {
    /* Narrow phones: name on the first row, navigation on its own row below. */
    .top {
      flex-wrap: wrap;
      row-gap: 0;
    }
    nav {
      width: 100%;
      gap: 14px;
    }
  }
  @media print {
    .top {
      display: none !important;
    }
  }
</style>
