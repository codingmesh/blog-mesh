---
import Icon from './Icon.astro';
import { getWriting } from '../lib/content';
const topics = [...new Set((await getWriting()).flatMap((post) => post.data.tags))].slice(0, 4);
---
<dialog id="search-dialog" aria-labelledby="search-title" data-pagefind-ignore>
  <div class="search-top"><h2 id="search-title">Find something to read</h2><button type="button" class="icon-button" id="search-close" aria-label="Close search"><Icon name="close" /></button></div>
  <label class="sr-only" for="search-input">Search writing and notes</label>
  <div class="search-field"><Icon name="search" /><input id="search-input" type="search" placeholder="Search articles, notes, or a keyword" autocomplete="off" enterkeyhint="search" aria-describedby="search-status" aria-controls="search-results" /></div>
  <div id="search-suggestions"><p>Explore a topic</p><div class="search-topics">{topics.map((topic) => <button type="button" data-search-topic={topic}>{topic}</button>)}</div></div>
  <p id="search-status" class="search-status" role="status" aria-live="polite" aria-atomic="true">Enter a keyword to search all writing and notes.</p>
  <ul id="search-results" aria-label="Search results" role="list" hidden></ul>
  <div id="search-recovery" hidden><button type="button" id="search-retry" class="text-button">Try again</button><a href="/writing/">Browse all writing</a></div>
  <div class="search-bottom"><span id="search-mode">Full-text search</span><span><kbd>↑</kbd> <kbd>↓</kbd> Navigate <kbd>esc</kbd> Close</span></div>
</dialog>
<script>
  import '../scripts/search';
</script>
