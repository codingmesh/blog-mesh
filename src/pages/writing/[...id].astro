---
import { render } from 'astro:content';
import '../../styles/prose.css';
import Base from '../../layouts/Base.astro';
import CodeWindows from '../../components/content/CodeWindows.astro';
import BackToTop from '../../components/content/BackToTop.astro';
import Lightbox from '../../components/content/Lightbox.astro';
import ReadingLine from '../../components/content/ReadingLine.astro';
import TableOfContents from '../../components/content/TableOfContents.astro';
import { mdxComponents } from '../../components/content/mdx-components';
import { formatDate, formatLabel, getAllWriting, isNote, postUrl, readingTime, type Post } from '../../lib/content';
import { site } from '../../config';

export async function getStaticPaths() {
  const posts = await getAllWriting();
  const seen = new Map<string, string>();
  for (const post of posts) {
    const owner = seen.get(post.id);
    if (owner && owner !== post.collection)
      throw new Error(`Article and note share the id "${post.id}". Rename one of them.`);
    seen.set(post.id, post.collection);
  }
  return posts.map((post) => {
    const siblings = posts.filter((candidate) => candidate.collection === post.collection && candidate.id !== post.id);
    const next =
      siblings.find((candidate) => candidate.data.tags.some((tag) => post.data.tags.includes(tag))) || siblings[0];
    return { params: { id: post.id }, props: { post, next } };
  });
}

interface Props {
  post: Post;
  next?: Post;
}
const { post, next } = Astro.props;
const { Content, headings } = await render(post);
// Sections only; the hidden footnotes heading from GitHub-flavored Markdown is not a section.
const toc = headings.filter(
  (heading) => (heading.depth === 2 || heading.depth === 3) && heading.slug !== 'footnote-label',
);
const note = isNote(post);
const label = formatLabel(post);
const listHref = note ? '/notes/' : '/writing/';
const source = note ? undefined : post.data.source;
const transitionName = `title-${post.collection}-${post.id}`;
---

<Base
  title={post.data.title}
  description={post.data.description}
  active={note ? 'notes' : 'writing'}
  crumb={{ label: note ? 'Notes' : 'Writing', href: listHref }}
  article
  publishedAt={post.data.date}
  image={`/og/${post.id}.png`}
  preload={[
    { weight: 400, style: 'normal' },
    { weight: 400, style: 'italic' },
    { weight: 700, style: 'normal' },
  ]}
>
  <ReadingLine />
  <BackToTop />
  <Lightbox />
  <article class="article wrap" data-pagefind-body>
    <header class="article-head">
      <h1 data-pagefind-meta="title" transition:name={transitionName}>
        {post.data.title}
      </h1>
      <meta data-pagefind-meta="description[content]" content={post.data.description} />
      {/* Head order per the typography standard: title, descriptive subtitle, source attribution, then the date
          line. Each fact appears once; the body does not restate them. */}
      {post.data.description && <p class="subtitle">{post.data.description}</p>}
      {source && (
        <p class="attribution">
          On{' '}
          <a href={source.url} target="_blank" rel="noopener noreferrer">
            <i>{source.title}</i>
            <span class="sr-only"> (opens in a new tab)</span>
          </a>{' '}
          by {source.author}
        </p>
      )}
      <p class="meta-line">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        {' · '}
        {readingTime(post.body)} minute read
      </p>
    </header>
    {toc.length > 1 && (
      <TableOfContents headings={toc} variant="side" markdownHref={`${postUrl(post).replace(/\/$/, '')}.md`} />
    )}
    {toc.length > 1 && <TableOfContents headings={toc} variant="inline" />}
    <div class="prose">
      <Content components={mdxComponents} />
    </div>
    <CodeWindows />
    <footer class="article-end" data-pagefind-ignore>
      {post.data.sample && (
        <p class="sample-note">
          This is an AI-assisted sample {label}.{' '}
          {source && 'Source summaries and additional reflections are labeled separately. '}It does not represent
          firsthand experience or original experimental results.
        </p>
      )}
      {!post.data.sample && !note && post.data.format === 'reading' && <p class="sample-note">{site.editorialNote}</p>}
      {next && (
        <a class="next" href={postUrl(next)}>
          <span class="next-label">Read next</span>
          <span class="next-title">{next.data.title}</span>
        </a>
      )}
    </footer>
  </article>
</Base>

<style>
  /* The head and the reading text share the 620px reading column; the rail hangs outside it. */
  .article {
    position: relative;
    --column: var(--reading);
  }
  /* Roles and gaps from docs/typography.md, section 4: article-title, article-subtitle, article-attribution,
     article-date; 8px title to subtitle, 16px subtitle to attribution, 36px to the date, 24px to the body. */
  .article-head {
    padding: 64px 0 24px;
  }
  .article-head h1 {
    font-size: 56px;
    margin: 0;
    overflow-wrap: anywhere;
  }
  .subtitle {
    margin: 8px 0 0;
    font: italic 400 22px/1.6 var(--serif);
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .attribution {
    margin: 12px 0 0;
    font: 400 16px/1.5 var(--serif);
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  .subtitle + .attribution {
    margin-top: 16px;
  }
  .attribution a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 3px;
  }
  .attribution a:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
  .meta-line {
    margin: 36px 0 0;
    font: 400 18px/1.6 var(--serif);
    color: var(--muted);
  }
  .prose {
    padding-top: 0;
  }
  /* The side contents list hangs in the right margin on wide screens only. */
  .article :global(.article-toc) {
    display: none;
  }
  .article :global(.mobile-toc) {
    display: block;
  }
  /* Laptops from 1000px get a narrower rail (620px column + 2 × 186px fits in 992px); from 1140px the full one
     (620px + 2 × 256px). */
  @media (min-width: 1000px) {
    /* Spans the article from the title to the end so the sticky block inside can follow the reader. */
    .article :global(.article-toc) {
      display: block;
      position: absolute;
      left: calc(100% + 36px);
      top: 72px;
      bottom: 0;
      width: 150px;
    }
    .article :global(.mobile-toc) {
      display: none;
    }
  }
  @media (min-width: 1140px) {
    .article :global(.article-toc) {
      left: calc(100% + 56px);
      width: 200px;
    }
  }
  .article-end {
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .sample-note {
    font: 400 16px/1.5 var(--serif);
    color: var(--muted);
    margin: 0 0 28px;
  }
  .next {
    display: block;
  }
  .next-label {
    display: block;
    font: 400 14px/1.6 var(--sans);
    color: var(--muted);
  }
  .next-title {
    font: 600 20px/1.4 var(--serif);
  }
  .next:hover .next-title {
    color: var(--accent);
  }
  @media (max-width: 600px) {
    .article-head {
      padding: 40px 0 24px;
    }
    .article-head h1 {
      font-size: 40px;
    }
    .subtitle {
      font-size: 20px;
    }
    .subtitle + .attribution {
      margin-top: 12px;
    }
    .meta-line {
      margin-top: 24px;
      font-size: 17px;
    }
  }
  @media print {
    .article-end,
    .article :global(.article-toc),
    .article :global(.mobile-toc) {
      display: none !important;
    }
  }
</style>
