---
import { render } from 'astro:content';
import '../../styles/prose.css';
import Base from '../../layouts/Base.astro';
import CodeWindows from '../../components/content/CodeWindows.astro';
import Comments from '../../components/content/Comments.astro';
import BackToTop from '../../components/content/BackToTop.astro';
import Lightbox from '../../components/content/Lightbox.astro';
import ReadingLine from '../../components/content/ReadingLine.astro';
import TableOfContents from '../../components/content/TableOfContents.astro';
import { mdxComponents } from '../../components/content/mdx-components';
import { formatDate, formatLabel, getAllWriting, isNote, postUrl, readingTime, type Post } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getAllWriting();
  const seen = new Map<string, string>();
  for (const post of posts) {
    const owner = seen.get(post.id);
    if (owner && owner !== post.collection)
      throw new Error(`Article and note share the id "${post.id}". Rename one of them.`);
    seen.set(post.id, post.collection);
  }
  return posts.map((post) => {
    const siblings = posts.filter((candidate) => candidate.collection === post.collection && candidate.id !== post.id);
    const next =
      siblings.find((candidate) => candidate.data.tags.some((tag) => post.data.tags.includes(tag))) || siblings[0];
    return { params: { id: post.id }, props: { post, next } };
  });
}

interface Props {
  post: Post;
  next?: Post;
}
const { post, next } = Astro.props;
const { Content, headings } = await render(post);
// Sections only; the hidden footnotes heading from GitHub-flavored Markdown is not a section.
const toc = headings.filter(
  (heading) => (heading.depth === 2 || heading.depth === 3) && heading.slug !== 'footnote-label',
);
const note = isNote(post);
const label = formatLabel(post);
const listHref = note ? '/notes/' : '/writing/';
const source = note ? undefined : post.data.source;
const topic = post.data.tags[0];
const transitionName = `title-${post.collection}-${post.id}`;
---

<Base
  title={post.data.title}
  description={post.data.description}
  active={note ? 'notes' : 'writing'}
  crumb={{ label: note ? 'Notes' : 'Writing', href: listHref }}
  article
  publishedAt={post.data.date}
  image={`/og/${post.id}.png`}
>
  <ReadingLine />
  <BackToTop />
  <Lightbox />
  <article class="article wrap" data-pagefind-body>
    <header class="article-head">
      <h1 data-pagefind-meta="title" transition:name={transitionName}>
        {post.data.title}
      </h1>
      <meta data-pagefind-meta="description[content]" content={post.data.description} />
      <dl class="fields">
        {source && (
          <div>
            <dt>Source</dt>
            <dd>
              <a href={source.url} target="_blank" rel="noopener noreferrer">
                {source.title}
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
              , by {source.author}
            </dd>
          </div>
        )}
        <div>
          <dt>Topic</dt>
          <dd>
            {topic && (note ? topic : <a href={`/writing/?tag=${encodeURIComponent(topic)}`}>{topic}</a>)}
            {topic && ' · '}
            {post.data.sample ? 'sample ' : ''}
            {label}
          </dd>
        </div>
        <div>
          <dt>Published</dt>
          <dd>
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            {' · '}
            {readingTime(post.body)} min read
          </dd>
        </div>
      </dl>
    </header>
    {toc.length > 1 && (
      <TableOfContents
        headings={toc}
        variant="side"
        minutes={readingTime(post.body)}
        markdownHref={`${postUrl(post).replace(/\/$/, '')}.md`}
      />
    )}
    {toc.length > 1 && <TableOfContents headings={toc} variant="inline" />}
    <div class="prose">
      <Content components={mdxComponents} />
    </div>
    <CodeWindows />
    <footer class="article-end" data-pagefind-ignore>
      {post.data.sample && (
        <p class="sample-note">
          This is an AI-assisted sample {label}.{' '}
          {source && 'Source summaries and additional reflections are labeled separately. '}It does not represent
          firsthand experience or original experimental results.
        </p>
      )}
      {next && (
        <a class="next" href={postUrl(next)}>
          <span class="next-label">Read next</span>
          <span class="next-title">{next.data.title}</span>
        </a>
      )}
    </footer>
    <Comments />
  </article>
</Base>

<style>
  .article {
    position: relative;
  }
  .article-head {
    padding: 64px 0 28px;
  }
  .article-head h1 {
    font-size: 36px;
    line-height: 1.18;
    letter-spacing: -0.02em;
    margin: 0 0 10px;
    overflow-wrap: anywhere;
  }
  /* Metadata as labeled fields: one glance, nothing to parse. */
  .fields {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px 28px;
    margin: 22px 0 0;
    max-width: 66ch;
  }
  .fields div {
    min-width: 0;
  }
  .fields dt {
    font: 500 11.5px/1.6 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 4px;
  }
  .fields dd {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .fields dd time {
    font: inherit;
    color: inherit;
  }
  .fields dd a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 3px;
  }
  .fields dd a:hover {
    text-decoration-color: currentColor;
  }
  .meta-line a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 3px;
  }
  .meta-line a:hover {
    text-decoration: underline;
  }
  .prose {
    padding-top: 12px;
  }
  /* The side contents list hangs in the right margin on wide screens only. */
  .article :global(.article-toc) {
    display: none;
  }
  .article :global(.mobile-toc) {
    display: block;
  }
  /* Laptops from 1100px get a narrower rail (720px column + 2 × 186px fits in 1092px); from 1240px the full one. */
  @media (min-width: 1100px) {
    /* Spans the article from the title to the end so the sticky block inside can follow the reader. */
    .article :global(.article-toc) {
      display: block;
      position: absolute;
      left: calc(100% + 36px);
      top: 72px;
      bottom: 0;
      width: 150px;
    }
    .article :global(.mobile-toc) {
      display: none;
    }
  }
  @media (min-width: 1240px) {
    .article :global(.article-toc) {
      left: calc(100% + 56px);
      width: 200px;
    }
  }
  .article-end {
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .sample-note {
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
    margin: 0 0 28px;
    max-width: 60ch;
  }
  .next {
    display: block;
  }
  .next-label {
    display: block;
    font: 400 13px/1.8 var(--mono);
    color: var(--muted);
  }
  .next-title {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  .next:hover .next-title {
    color: var(--accent);
  }
  @media (max-width: 600px) {
    .article-head {
      padding: 40px 0 24px;
    }
    .article-head h1 {
      font-size: 29px;
    }
  }
  @media print {
    .article-end,
    .article :global(.article-toc),
    .article :global(.mobile-toc) {
      display: none !important;
    }
  }
</style>
