---
import { render } from 'astro:content';
import '../../styles/prose.css';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import CodeWindows from '../../components/content/CodeWindows.astro';
import Comments from '../../components/content/Comments.astro';
import SourceLine from '../../components/content/SourceLine.astro';
import TableOfContents from '../../components/content/TableOfContents.astro';
import { mdxComponents } from '../../components/content/mdx-components';
import { formatDate, formatLabel, getAllWriting, isNote, postUrl, readingTime, type Post } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getAllWriting();
  const seen = new Map<string, string>();
  for (const post of posts) {
    const owner = seen.get(post.id);
    if (owner && owner !== post.collection)
      throw new Error(`Article and note share the id "${post.id}". Rename one of them.`);
    seen.set(post.id, post.collection);
  }
  return posts.map((post) => {
    const siblings = posts.filter((candidate) => candidate.collection === post.collection && candidate.id !== post.id);
    const next =
      siblings.find((candidate) => candidate.data.tags.some((tag) => post.data.tags.includes(tag))) || siblings[0];
    return { params: { id: post.id }, props: { post, next } };
  });
}

interface Props {
  post: Post;
  next?: Post;
}
const { post, next } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const note = isNote(post);
const label = formatLabel(post);
const listHref = note ? '/notes/' : '/writing/';
const source = note ? undefined : post.data.source;
---

<Base
  title={post.data.title}
  description={post.data.description}
  active={note ? 'notes' : 'writing'}
  article
  publishedAt={post.data.date}
>
  <article class="article" data-pagefind-body>
    <div class="article-main column">
      <div class="article-topline">
        <a class="quiet-link article-back" href={listHref} data-pagefind-ignore>
          <Icon name="arrow" size={16} />
          {note ? 'All notes' : 'All writing'}
        </a>
        {post.data.tags[0] && <span class="category-label">{post.data.tags[0]}</span>}
      </div>
      <header class="article-header">
        <h1 data-pagefind-meta="title">{post.data.title}</h1>
        <p class="article-description" data-pagefind-meta="description">
          {post.data.description}
        </p>
        <div class="post-meta">
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <span>{readingTime(post.body)} min read</span>
          <span>
            {post.data.sample ? 'Sample ' : ''}
            {label}
          </span>
        </div>
        {source && <SourceLine source={source} />}
      </header>
      {toc.length > 1 && <TableOfContents headings={toc} variant="inline" />}
      <div class="prose">
        <Content components={mdxComponents} />
      </div>
      <CodeWindows />
      <footer class="article-end" data-pagefind-ignore>
        <div class="tags">
          {post.data.tags.map((tag) =>
            note ? <span># {tag}</span> : <a href={`/writing/?tag=${encodeURIComponent(tag)}`}># {tag}</a>,
          )}
        </div>
        {post.data.sample && (
          <p>
            This is an AI-assisted sample {label}.{' '}
            {source && 'Source summaries and additional reflections are labeled separately. '}It does not represent
            firsthand experience or original experimental results.
          </p>
        )}
        <div class="article-actions">
          <a href={listHref} class="quiet-link">
            Back to {note ? 'notes' : 'writing'} <Icon name="arrow" size={16} />
          </a>
          <a href="#main" class="quiet-link">
            {' '}
            Back to top ↑{' '}
          </a>
        </div>
        {next && (
          <a class="related-post" href={postUrl(next)}>
            <span>Read next</span>
            <h2 class="link-line">{next.data.title}</h2>
          </a>
        )}
      </footer>
      <Comments />
    </div>
    {toc.length > 1 && (
      <aside class="article-side">
        <TableOfContents headings={toc} variant="side" />
      </aside>
    )}
  </article>
</Base>

<style>
  /* One centered measure. On wide screens the table of contents sits in the right margin, never shifting the text. */
  .article {
    padding-top: 28px;
  }
  .article-side {
    display: none;
  }
  .article :global(.mobile-toc) {
    display: block;
  }
  @media (min-width: 1180px) {
    .article {
      display: grid;
      grid-template-columns: minmax(24px, 1fr) minmax(0, var(--measure)) minmax(24px, 1fr);
      column-gap: 40px;
    }
    .article-main {
      grid-column: 2;
      width: auto;
      margin: 0;
    }
    .article-side {
      display: block;
      grid-column: 3;
      align-self: start;
      position: sticky;
      top: 40px;
      max-width: 220px;
      padding-top: 160px;
    }
    .article :global(.mobile-toc) {
      display: none;
    }
  }
  .article-back {
    margin: 0;
  }
  .article-back :global(svg) {
    transform: rotate(180deg);
  }
  .article-topline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-bottom: 28px;
  }
  .category-label {
    color: var(--muted);
    font: 500 13px/1.6 var(--mono);
  }
  .article-header h1 {
    font-size: clamp(32px, 4.4vw, 46px);
    letter-spacing: -0.03em;
    line-height: 1.08;
    color: var(--accent);
    margin: 0 0 14px;
    overflow-wrap: anywhere;
  }
  .article-description {
    font-size: 20px;
    line-height: 1.45;
    margin: 0 0 16px;
    max-width: 52ch;
  }
  .article-header :global(.source-line) {
    margin: 18px 0 0;
  }
  .article-header {
    padding-bottom: 28px;
    margin-bottom: 32px;
    border-bottom: 1px solid var(--line);
    position: relative;
  }
  .article-header::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 56px;
    height: 2px;
    background: var(--accent);
  }
  .article-end {
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .tags {
    display: flex;
    gap: 6px 18px;
    flex-wrap: wrap;
  }
  .tags a,
  .tags > span {
    font: 500 13px/1.6 var(--mono);
    color: var(--accent);
  }
  .tags a:hover {
    text-decoration: underline;
  }
  .article-end > p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
    margin: 20px 0 24px;
    max-width: 56ch;
  }
  .article-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
  }
  .related-post {
    display: block;
    margin-top: 48px;
    padding: 22px 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    transition: border-color 120ms var(--ease);
  }
  .related-post:hover {
    border-color: var(--accent);
  }
  .related-post > span {
    display: block;
    color: var(--muted);
    font: 500 13px/1.6 var(--mono);
    margin-bottom: 6px;
  }
  .related-post h2 {
    display: inline;
    font-size: 26px;
    letter-spacing: -0.025em;
    color: var(--accent);
    background-size: 0 2px;
  }
  .related-post:hover h2 {
    background-size: 100% 2px;
  }
  @media (max-width: 540px) {
    .article {
      padding-top: 18px;
    }
    .article-topline {
      margin-bottom: 18px;
    }
    .article-header h1 {
      font-size: 31px;
      line-height: 1.1;
      margin-bottom: 12px;
    }
    .article-description {
      font-size: 17px;
      margin-bottom: 10px;
    }
    .article-header {
      padding-bottom: 20px;
      margin-bottom: 24px;
    }
    .related-post {
      padding: 18px;
    }
    .related-post h2 {
      font-size: 23px;
    }
  }
  @media (max-width: 360px) {
    .article-header h1 {
      font-size: 28px;
    }
  }
  @media print {
    .article {
      display: block;
      padding: 0;
    }
    .article-back,
    .article-end,
    .article-side {
      display: none !important;
    }
  }
</style>
