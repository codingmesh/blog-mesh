---
import { render } from 'astro:content';
import '../../styles/prose.css';
import Base from '../../layouts/Base.astro';
import CodeWindows from '../../components/content/CodeWindows.astro';
import Comments from '../../components/content/Comments.astro';
import BackToTop from '../../components/content/BackToTop.astro';
import ReadingLine from '../../components/content/ReadingLine.astro';
import SourceLine from '../../components/content/SourceLine.astro';
import TableOfContents from '../../components/content/TableOfContents.astro';
import { mdxComponents } from '../../components/content/mdx-components';
import { formatDate, formatLabel, getAllWriting, isNote, postUrl, readingTime, type Post } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getAllWriting();
  const seen = new Map<string, string>();
  for (const post of posts) {
    const owner = seen.get(post.id);
    if (owner && owner !== post.collection)
      throw new Error(`Article and note share the id "${post.id}". Rename one of them.`);
    seen.set(post.id, post.collection);
  }
  return posts.map((post) => {
    const kin = posts.filter((candidate) => candidate.collection === post.collection);
    const siblings = kin.filter((candidate) => candidate.id !== post.id);
    const next =
      siblings.find((candidate) => candidate.data.tags.some((tag) => post.data.tags.includes(tag))) || siblings[0];
    const number = String(kin.findIndex((candidate) => candidate.id === post.id) + 1).padStart(2, '0');
    return { params: { id: post.id }, props: { post, next, number } };
  });
}

interface Props {
  post: Post;
  next?: Post;
  number: string;
}
const { post, next, number } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const note = isNote(post);
const label = formatLabel(post);
const listHref = note ? '/notes/' : '/writing/';
const source = note ? undefined : post.data.source;
const topic = post.data.tags[0];
const transitionName = `title-${post.collection}-${post.id}`;
---

<Base
  title={post.data.title}
  description={post.data.description}
  active={note ? 'notes' : 'writing'}
  article
  publishedAt={post.data.date}
  image={`/og/${post.id}.png`}
>
  <ReadingLine />
  <BackToTop />
  <article class="article wrap" data-pagefind-body>
    <header class="article-head">
      <span class="entry-num" aria-hidden="true">
        {number}
      </span>
      <p class="eyebrow">
        <span class="crumb-num">
          {number}
          <span> / </span>
        </span>
        <a href={listHref} data-pagefind-ignore>
          {topic || (note ? 'Notes' : 'Writing')}
        </a>
        <span>
          {' '}
          / {post.data.sample ? 'Sample ' : ''}
          {label}
        </span>
      </p>
      <h1 data-pagefind-meta="title" transition:name={transitionName}>
        {post.data.title}
      </h1>
      <p class="lede" data-pagefind-meta="description">
        {post.data.description}
      </p>
      <p class="meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span>{readingTime(post.body)} min read</span>
      </p>
      {source && <SourceLine source={source} />}
    </header>
    {toc.length > 1 && <TableOfContents headings={toc} variant="side" />}
    {toc.length > 1 && <TableOfContents headings={toc} variant="inline" />}
    <div class="prose">
      <Content components={mdxComponents} />
    </div>
    <CodeWindows />
    <footer class="article-end" data-pagefind-ignore>
      <div class="tags">
        {post.data.tags.map((tag) =>
          note ? <span>{tag}</span> : <a href={`/writing/?tag=${encodeURIComponent(tag)}`}>{tag}</a>,
        )}
      </div>
      {post.data.sample && (
        <p class="sample-note">
          This is an AI-assisted sample {label}.{' '}
          {source && 'Source summaries and additional reflections are labeled separately. '}It does not represent
          firsthand experience or original experimental results.
        </p>
      )}
      <div class="article-actions">
        <a href={listHref} class="quiet-link">
          ← Back to {note ? 'notes' : 'writing'}
        </a>
        <a href="#main" class="quiet-link">
          Back to top ↑
        </a>
      </div>
      {next && (
        <a class="related" href={postUrl(next)}>
          <span class="label">Read next</span>
          <h2>{next.data.title}</h2>
          <p>{next.data.description}</p>
        </a>
      )}
    </footer>
    <Comments />
  </article>
</Base>

<style>
  .article {
    position: relative;
  }
  .article-head {
    position: relative;
    padding: 72px 0 40px;
  }
  .article-head .eyebrow {
    margin-bottom: 22px;
  }
  .article-head .eyebrow a:hover {
    text-decoration: underline;
  }
  /* The entry's index numeral, large and faint, in the top right of the header on wide screens. */
  .entry-num {
    display: none;
    position: absolute;
    right: 0;
    top: 60px;
    font: 500 128px/1 var(--mono);
    letter-spacing: -0.06em;
    color: var(--line);
    pointer-events: none;
    user-select: none;
  }
  .crumb-num {
    display: inline;
  }
  @media (min-width: 900px) {
    .entry-num {
      display: block;
    }
    .crumb-num {
      display: none;
    }
    .article-head h1 {
      max-width: 15ch;
    }
  }
  .article-head h1 {
    font-size: clamp(36px, 5.4vw, 58px);
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin: 0 0 20px;
    overflow-wrap: anywhere;
    position: relative;
  }
  .lede {
    font-size: 21px;
    line-height: 1.45;
    color: var(--muted);
    max-width: 52ch;
    margin: 0 0 20px;
  }
  .article :global(.source-line) {
    border-top: 1px solid var(--line);
    padding-top: 16px;
    margin: 28px 0 0;
  }
  /* The side contents list hangs in the right margin on wide screens only. */
  .article :global(.article-toc) {
    display: none;
  }
  .article :global(.mobile-toc) {
    display: block;
  }
  @media (min-width: 1280px) {
    .article :global(.article-toc) {
      display: block;
      position: absolute;
      left: calc(100% + 56px);
      top: 96px;
      width: 200px;
    }
    .article :global(.mobile-toc) {
      display: none;
    }
  }
  .article-end {
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .tags a,
  .tags > span {
    font: 500 13px/1.6 var(--sans);
    color: var(--muted);
    padding: 5px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  .tags a:hover {
    color: var(--ink);
    border-color: var(--accent);
  }
  .sample-note {
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
    margin: 20px 0 24px;
    max-width: 60ch;
  }
  .article-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 8px;
  }
  .related {
    display: block;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--ink);
  }
  .related .label {
    display: block;
    margin-bottom: 10px;
  }
  .related h2 {
    font-size: 30px;
    letter-spacing: -0.03em;
    margin: 0 0 8px;
  }
  .related:hover h2 {
    color: var(--accent);
  }
  .related p {
    color: var(--muted);
    font-size: 16px;
    max-width: 54ch;
  }
  @media (max-width: 600px) {
    .article-head {
      padding: 44px 0 28px;
    }
    .article-head .eyebrow {
      margin-bottom: 16px;
    }
    .article-head h1 {
      font-size: 34px;
      margin-bottom: 14px;
    }
    .lede {
      font-size: 18px;
      margin-bottom: 14px;
    }
    .related h2 {
      font-size: 26px;
    }
  }
  @media print {
    .article-end,
    .entry-num,
    .article :global(.article-toc),
    .article :global(.mobile-toc) {
      display: none !important;
    }
  }
</style>
