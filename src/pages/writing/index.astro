---
import Base from '../../layouts/Base.astro';
import Feed from '../../components/content/Feed.astro';
import PostRow from '../../components/content/PostRow.astro';
import { getArticles } from '../../lib/content';
const posts = await getArticles();
const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
const years = [...new Set(posts.map((post) => post.data.date.getUTCFullYear()))];
---

<Base title="Writing" active="writing">
  <div class="column page-tall">
    <header class="page-intro">
      <h1>Writing</h1>
      <p>
        Technical essays and reading notes. <span id="post-count">{posts.length}</span>
        <span id="post-noun">{posts.length === 1 ? 'article' : 'articles'}</span>, newest first.
      </p>
    </header>
    <div class="archive-tools" role="group" aria-label="Filter by topic">
      <button class="filter-button" data-tag="" aria-pressed="true">
        All
      </button>
      {tags.map((tag) => (
        <button class="filter-button" data-tag={tag} aria-pressed="false">
          {tag}
        </button>
      ))}
    </div>
    <p id="filter-status" class="sr-only" role="status"></p>
    <div id="filter-empty" hidden>
      <p id="filter-empty-message"></p>
      <button type="button" class="text-button" id="filter-reset">
        View all writing
      </button>
    </div>
    {years.map((year) => (
      <section class="archive-group" aria-label={`${year} archive`}>
        <h2 class="archive-year">{year}</h2>
        <Feed>
          {posts
            .filter((post) => post.data.date.getUTCFullYear() === year)
            .map((post) => (
              <PostRow post={post} heading="h3" />
            ))}
        </Feed>
      </section>
    ))}
    <p class="reading-disclosure">
      These sample reading notes were prepared with AI assistance. Each article identifies its sources and separates the
      summary from further reflection.
    </p>
  </div>
</Base>

<script>
  import { initTopicFilters } from '../../scripts/filters';
  initTopicFilters();
</script>

<style>
  .archive-tools {
    display: flex;
    align-items: center;
    gap: 0 18px;
    flex-wrap: wrap;
    margin: 4px 0 28px;
  }
  .filter-button {
    padding: 10px 0;
    border: 0;
    background: transparent;
    color: var(--muted);
    font: 500 13px/1.6 var(--mono);
    min-height: 44px;
  }
  .filter-button:hover {
    color: var(--ink);
  }
  .filter-button[aria-pressed='true'] {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
  .archive-year {
    font: 500 13px/1.6 var(--mono);
    color: var(--muted);
    letter-spacing: 0;
    margin: 44px 0 22px;
  }
  .archive-group:first-of-type .archive-year {
    margin-top: 0;
  }
  #filter-empty {
    padding: 24px 0;
    color: var(--muted);
  }
  #filter-empty p {
    margin-bottom: 10px;
    overflow-wrap: anywhere;
  }
  @media (max-width: 540px) {
    .archive-tools {
      gap: 0 16px;
      margin-bottom: 20px;
    }
  }
</style>
