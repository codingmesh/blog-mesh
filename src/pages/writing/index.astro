---
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/content/PostRow.astro';
import { getArticles } from '../../lib/content';
import { site } from '../../config';
const posts = await getArticles();
const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
---

<Base title="Writing" active="writing" wind>
  <div class="wrap">
    <header class="page-head">
      <h1>Writing</h1>
      <p>
        Technical essays and reading notes. <span id="post-count">{posts.length}</span>{' '}
        <span id="post-noun">{posts.length === 1 ? 'article' : 'articles'}</span>, newest first.
      </p>
    </header>
    <div class="archive-tools" role="group" aria-label="Filter by topic">
      <button class="filter-button" data-tag="" aria-pressed="true">
        All
      </button>
      {tags.map((tag) => (
        <button class="filter-button" data-tag={tag} aria-pressed="false">
          {tag}
        </button>
      ))}
    </div>
    <p id="filter-status" class="sr-only" role="status"></p>
    <div id="filter-empty" hidden>
      <p id="filter-empty-message"></p>
      <button type="button" class="text-button" id="filter-reset">
        View all writing
      </button>
    </div>
    <ul class="index archive-list" role="list">
      {posts.map((post) => (
        <PostRow post={post} heading="h2" />
      ))}
    </ul>
    <p class="reading-disclosure">{site.editorialNote}</p>
  </div>
</Base>

<script>
  import { onPageLoad } from '../../scripts/page';
  import { initTopicFilters } from '../../scripts/filters';
  onPageLoad(initTopicFilters);
</script>

<style>
  .archive-tools {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--line);
  }
  .archive-list {
    padding-top: 16px;
  }
  .filter-button {
    padding: 7px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font: 500 15px/1.4 var(--sans);
    min-height: 36px;
  }
  .filter-button:hover {
    color: var(--ink);
    border-color: var(--accent);
  }
  .filter-button[aria-pressed='true'] {
    color: var(--paper);
    background: var(--accent);
    border-color: var(--accent);
  }
  #filter-empty {
    padding: 24px 0;
    color: var(--muted);
  }
  #filter-empty p {
    margin-bottom: 10px;
    overflow-wrap: anywhere;
  }
</style>
