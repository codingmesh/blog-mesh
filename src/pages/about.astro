---
import '../styles/prose.css';
import Base from '../layouts/Base.astro';
import { site } from '../config';
---

<Base title="About" active="about" wind>
  <div class="wrap">
    <header class="page-head">
      <h1>About {site.name}</h1>
      <p>{site.tagline}</p>
    </header>
    <div class="prose">
      <p>{site.about.intro}</p>
      <p>{site.about.scope}</p>
      <h2>About this blog</h2>
      <p>
        This site focuses on software and reading notes. You can switch between light and dark themes, search the
        archive, or subscribe through <a href="/rss.xml">RSS</a>.
      </p>
      <h2>Sources and interpretation</h2>
      <p>{site.about.method}</p>
      <p>
        The reading list starts with engineering articles from <a href="https://claude.dev/blog/">claude.dev</a>. The{' '}
        <a href="/writing/a-note-is-a-question/">editorial method</a> explains how those sources are used.
      </p>
    </div>
    <aside class="about-note">{site.editorialNote}</aside>
  </div>
</Base>

<style>
  .about-note {
    margin: 48px 0 0;
    padding: 18px 0 0;
    border-top: 1px solid var(--line);
    font: 14px/1.6 var(--sans);
    color: var(--muted);
    max-width: 60ch;
  }
</style>
