---
import Base from '../layouts/Base.astro';
import { site } from '../config';
---

<Base title="About" active="about">
  <div class="column page-tall about-page">
    <header class="page-intro">
      <p class="intro-greeting">A little background</p>
      <h1>About {site.name}</h1>
      <p>{site.tagline}</p>
    </header>
    <div class="prose">
      <p>
        This is my corner of the internet for questions from things I read, ideas from writing code, and topics worth a
        second look.
      </p>
      <p>
        Articles make room for longer arguments. Notes hold smaller ideas that are still developing. The goal is to
        leave useful context for other readers and for my future self.
      </p>
      <h2>About this blog</h2>
      <p>
        This site focuses on software and reading notes. You can switch between light and dark themes, search the
        archive, or subscribe through <a href="/rss.xml">RSS</a>.
      </p>
      <p>
        The first reading notes draw on engineering articles from claude.dev. Each one links to its source and separates
        the author's claims from additional reflections.
      </p>
    </div>
    <aside class="about-note">
      This is a preview profile, without a verified biography or contact details. The sample notes were prepared with AI
      assistance and do not represent experiments personally conducted by the site owner.
    </aside>
  </div>
</Base>

<style>
  .about-page :global(.prose) {
    margin-bottom: 48px;
  }
  .about-note {
    padding: 16px 20px;
    border-left: 2px solid var(--accent);
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
    margin: 32px 0;
  }
</style>
