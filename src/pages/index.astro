---
import Base from '../layouts/Base.astro';
import PostRow from '../components/content/PostRow.astro';
import { getArticles, getNotes } from '../lib/content';
import { site } from '../config';
const [articles, notes] = await Promise.all([getArticles(), getNotes()]);
// The description opens with the tagline; the hero shows only what the headline does not already say.
const heroSub = site.description.startsWith(site.tagline)
  ? site.description.slice(site.tagline.length).trim()
  : site.description;
// The newest article is shown once, in the Latest block; the rows carry the rest.
const [latest, ...rest] = articles;
---

<Base
  wind
  preload={[
    { weight: 400, style: 'normal' },
    { weight: 600, style: 'normal' },
    { weight: 700, style: 'normal' },
  ]}
>
  <div class="wrap">
    <header class="hero">
      <h1>{site.tagline}</h1>
      <p>{heroSub}</p>
    </header>
    {latest && (
      <section class="section" aria-labelledby="latest-label">
        <h2 id="latest-label" class="section-title">
          Latest
        </h2>
        <PostRow post={latest} variant="latest" heading="h3" />
      </section>
    )}
    <section class="section" aria-labelledby="writing-label">
      <div class="section-head">
        <h2 id="writing-label" class="section-title">
          {latest ? 'Earlier writing' : 'Writing'}
        </h2>
        {rest.length > 8 && <a href="/writing/">All writing →</a>}
      </div>
      <ul class="index" role="list">
        {rest.slice(0, 8).map((post) => (
          <PostRow post={post} />
        ))}
      </ul>
      {!articles.length && <p class="empty-copy">The first article is on its way.</p>}
      {articles.length === 1 && <p class="empty-copy">More is on the way.</p>}
    </section>
    {notes.length > 0 && (
      <section class="section" aria-labelledby="notes-label">
        <div class="section-head">
          <h2 id="notes-label" class="section-title">
            Notes
          </h2>
          {notes.length > 5 && <a href="/notes/">All notes →</a>}
        </div>
        <ul class="index" role="list">
          {notes.slice(0, 5).map((post) => (
            <PostRow post={post} />
          ))}
        </ul>
      </section>
    )}
    <p class="reading-disclosure">{site.editorialNote}</p>
  </div>
</Base>

<style>
  .hero {
    padding: 72px 0 40px;
    border-bottom: 1px solid var(--line);
  }
  /* home-title and summary roles from the typography standard. */
  .hero h1 {
    font-size: 48px;
    line-height: 1.15;
    margin: 0 0 8px;
    max-width: 18ch;
  }
  .hero p {
    font: 400 20px/1.6 var(--serif);
    color: var(--muted);
    max-width: 46ch;
  }
  .section {
    padding: 36px 0 8px;
  }
  .section + .section {
    border-top: 1px solid var(--line);
  }
  .section .section-head {
    margin: 0 0 16px;
  }
  .section > .section-title {
    margin-bottom: 16px;
  }
  @media (max-width: 600px) {
    .hero {
      padding: 48px 0 32px;
    }
    .hero h1 {
      font-size: 36px;
    }
    .hero p {
      font-size: 18px;
    }
  }
</style>
