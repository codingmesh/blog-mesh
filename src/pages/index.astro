---
import Base from '../layouts/Base.astro';
import Feed from '../components/content/Feed.astro';
import PostRow from '../components/content/PostRow.astro';
import Icon from '../components/Icon.astro';
import { getArticles, getNotes } from '../lib/content';
import { site } from '../config';
const [articles, notes] = await Promise.all([getArticles(), getNotes()]);
---

<Base home>
  <div class="home column">
    <p class="home-kicker">{site.focus}</p>
    <Feed class="home-feed">
      {articles.slice(0, 6).map((post) => (
        <PostRow post={post} />
      ))}
    </Feed>
    {!articles.length && <p class="empty-copy">The first article is on its way.</p>}
    {articles.length > 6 && (
      <p class="feed-more">
        <a class="quiet-link" href="/writing/">
          All writing <Icon name="arrow" size={14} />
        </a>
      </p>
    )}
    {notes.length > 0 && (
      <section class="feed-section" aria-labelledby="notes-label">
        <h2 id="notes-label" class="feed-label">
          Notes
        </h2>
        <Feed compact>
          {notes.slice(0, 4).map((post) => (
            <PostRow post={post} variant="note" heading="h3" />
          ))}
        </Feed>
        <p class="feed-more">
          <a class="quiet-link" href="/notes/">
            All notes <Icon name="arrow" size={14} />
          </a>
        </p>
      </section>
    )}
    <p class="reading-disclosure">
      These sample reading notes draw on claude.dev. Sources and personal reflections are clearly separated.
    </p>
  </div>
</Base>

<style>
  .home-kicker {
    font: 500 13px/1.6 var(--mono);
    color: var(--muted);
    margin-top: 44px;
  }
  .home :global(.home-feed) {
    margin-top: 26px;
  }
  .home :global(.home-feed > :first-child .feed-title) {
    font-size: clamp(34px, 4.6vw, 50px);
    letter-spacing: -0.032em;
  }
  .home :global(.home-feed > :first-child .feed-summary) {
    font-size: 20px;
    max-width: 50ch;
  }
  .home :global(.home-feed > :first-child) {
    padding-bottom: 10px;
  }
  .feed-section {
    margin-top: 88px;
  }
  .feed-label {
    font: 500 13px/1.6 var(--mono);
    color: var(--muted);
    letter-spacing: 0;
    margin-bottom: 22px;
  }
  .feed-more {
    margin-top: 36px;
  }
  @media (max-width: 540px) {
    .home-kicker {
      margin-top: 24px;
    }
    .home :global(.home-feed) {
      margin-top: 18px;
    }
    .home :global(.home-feed > :first-child .feed-title) {
      font-size: 33px;
    }
    .home :global(.home-feed > :first-child .feed-summary) {
      font-size: 18px;
    }
    .feed-section {
      margin-top: 64px;
    }
  }
</style>
