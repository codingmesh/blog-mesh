---
import Base from '../layouts/Base.astro';
import PostRow from '../components/content/PostRow.astro';
import { getArticles, getNotes } from '../lib/content';
import { site } from '../config';
const [articles, notes] = await Promise.all([getArticles(), getNotes()]);
// The description opens with the tagline; the hero shows only what the headline does not already say.
const heroSub = site.description.startsWith(site.tagline)
  ? site.description.slice(site.tagline.length).trim()
  : site.description;
const number = (index: number) => String(index + 1).padStart(2, '0');
---

<Base wind>
  <div class="wrap">
    <header class="hero">
      <h1>{site.tagline}</h1>
      <p>{heroSub}</p>
    </header>
    <ol class="index" role="list">
      {articles.slice(0, 8).map((post, index) => (
        <PostRow post={post} number={number(index)} />
      ))}
    </ol>
    {!articles.length && <p class="empty-copy">The first article is on its way.</p>}
    {articles.length > 8 && (
      <p class="more">
        <a href="/writing/">All writing →</a>
      </p>
    )}
    {notes.length > 0 && (
      <section aria-labelledby="notes-label">
        <div class="section-head">
          <h2 id="notes-label" class="label">
            Notes
          </h2>
          <a href="/notes/">All notes →</a>
        </div>
        <ul class="index" role="list">
          {notes.slice(0, 5).map((post) => (
            <PostRow post={post} variant="note" heading="h3" />
          ))}
        </ul>
      </section>
    )}
    <p class="reading-disclosure">
      These sample reading notes draw on claude.dev. Sources and personal reflections are clearly separated.
    </p>
  </div>
</Base>

<style>
  .hero {
    padding: 88px 0 56px;
    border-bottom: 1px solid var(--ink);
  }
  .hero h1 {
    font-size: clamp(40px, 6vw, 66px);
    line-height: 1;
    letter-spacing: -0.035em;
    margin: 0 0 20px;
    max-width: 12ch;
  }
  .hero p {
    font-size: 19px;
    color: var(--muted);
    max-width: 44ch;
  }
  .more {
    padding: 24px 0 0;
  }
  .more a {
    font-size: 15px;
    color: var(--accent);
  }
  .more a:hover {
    text-decoration: underline;
  }
  @media (max-width: 600px) {
    .hero {
      padding: 56px 0 40px;
    }
    .hero h1 {
      font-size: 40px;
    }
    .hero p {
      font-size: 17px;
    }
  }
</style>
